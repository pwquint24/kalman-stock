            }
           ],
           "\[IndentingNewLine]",
           RowBox[
            {
             RowBox[
              {
               RowBox[
                {
                 "R2",
                 "=",
                 RowBox[
                  {
                   RowBox[{"sigma", "^", "2"}],
                   " ",
