                    }
                   ]
                  }
                 ],
                 "}"
                }
               ]
              }
             ],
             ";"
            }
           ],
           "\[IndentingNewLine]",
           RowBox[
            {
             RowBox[
              {
               "H2",
               "=",
               RowBox[
                {
                 "{",
                 RowBox[
                  {
                   RowBox[
                    {
                     "{",
                     RowBox[
                      {"1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}
                     ],
                     "}"
                    }
                   ],
                   ",",
                   RowBox[
                    {
                     "{",
