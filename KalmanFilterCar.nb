     Cell[
      CellGroupData[
       {
        Cell["9. The 2D race track", "Section"],
        Cell[
         TextData[
          {
           "So far we have assumed a straight line. For a real race track we extend the model to two dimensions: instead of a single position we estimate ",
           Cell[
            BoxData[
             FormBox[
              TemplateBox[
               <|
                "boxes" ->
                 FormBox[
                  RowBox[
                   {
                    SubscriptBox[
                     StyleBox["x", FontSlant -> "Bold"],
                     StyleBox["t", "TI"]
                    ],
                    "\[LongEqual]",
                    RowBox[
                     {
                      "(",
                      Cell[
                       BoxData[
                        FormBox[
                         GridBox[
                          {
                           {
                            Cell[
                             TextData[
                              {
                               " ",
                               Cell[BoxData[StyleBox["x", "TI"]], "InlineFormula"],
                               " "
                              }
                             ]
                            ]
                           },
                           {
                            Cell[
                             TextData[
                              {
                               " ",
                               Cell[BoxData[StyleBox["y", "TI"]], "InlineFormula"],
                               " "
                              }
                             ]
                            ]
                           },
                           {
                            Cell[
                             TextData[
                              {
                               " ",
                               Cell[
                                BoxData[
                                 SubscriptBox[StyleBox["v", "TI"], StyleBox["x", "TI"]]
                                ],
                                "InlineFormula"
                               ],
                               " "
                              }
                             ]
                            ]
                           },
                           {
                            Cell[
                             TextData[
                              {
                               " ",
                               Cell[
                                BoxData[
                                 SubscriptBox[StyleBox["v", "TI"], StyleBox["y", "TI"]]
                                ],
                                "InlineFormula"
                               ],
                               " "
                              }
                             ]
                            ]
                           },
                           {
                            Cell[
                             TextData[
                              {
                               " ",
                               Cell[
                                BoxData[
                                 SubscriptBox[StyleBox["a", "TI"], StyleBox["x", "TI"]]
                                ],
                                "InlineFormula"
                               ],
                               " "
                              }
                             ]
                            ]
                           },
                           {
                            Cell[
                             TextData[
                              {
                               " ",
                               Cell[
                                BoxData[
                                 SubscriptBox[StyleBox["a", "TI"], StyleBox["y", "TI"]]
                                ],
                                "InlineFormula"
                               ],
                               " "
                              }
                             ]
                            ]
                           }
                          }
                         ],
                         TraditionalForm
                        ]
                       ]
                      ],
                      ")"
                     }
                    ]
                   }
                  ],
                  TraditionalForm
                 ],
                "errors" -> { },
                "input" -> "\\mathbf{x}_t = \\begin{pmatrix} x \\\\ y \\\\ v_x \\\\ v_y \\\\ a_x \\\\ a_y \\end{pmatrix}",
                "state" -> "Boxes"
               |>,
               "TeXAssistantTemplate"
              ],
              TraditionalForm
             ]
            ]
           ],
           "applying the same constant-acceleration model independently to the two coordinate directions, with measurements ",
           Cell[
            BoxData[
             FormBox[
              TemplateBox[
               <|
                "boxes" ->
                 FormBox[
                  RowBox[
                   {
                    SubscriptBox[
                     StyleBox["z", FontSlant -> "Bold"],
                     StyleBox["t", "TI"]
                    ],
                    "\[LongEqual]",
                    RowBox[
                     {
                      "(",
                      Cell[
                       BoxData[
                        FormBox[
                         GridBox[
                          {
                           {
                            Cell[
                             TextData[
                              {
                               " ",
                               Cell[
                                BoxData[SubscriptBox[StyleBox["x", "TI"], "measured"]],
                                "InlineFormula"
                               ],
                               " "
                              }
                             ]
                            ]
                           },
                           {
                            Cell[
                             TextData[
                              {
                               " ",
                               Cell[
                                BoxData[SubscriptBox[StyleBox["y", "TI"], "measured"]],
                                "InlineFormula"
                               ],
                               " "
                              }
                             ]
                            ]
                           }
                          }
                         ],
                         TraditionalForm
                        ]
                       ]
                      ],
                      ")"
                     }
                    ]
                   }
                  ],
                  TraditionalForm
                 ],
                "errors" -> { },
                "input" -> "\\mathbf{z}_t = \\begin{pmatrix} x_{\\text{measured}} \\\\ y_{\\text{measured}} \\end{pmatrix}",
                "state" -> "Boxes"
               |>,
               "TeXAssistantTemplate"
              ],
              TraditionalForm
             ]
            ]
           ],
           "The full implementation: "
          }
         ],
         "CodeText"
        ],
        Cell[
         BoxData[
          {
           RowBox[{RowBox[{"SeedRandom", "[", "7", "]"}], ";"}],
           "\[IndentingNewLine]",
           RowBox[{RowBox[{"dt", "=", "0.1"}], ";"}],
           "\[IndentingNewLine]",
           RowBox[
            {
             RowBox[{RowBox[{"n", "=", "300"}], ";"}],
             " ",
             RowBox[
              {"(*", " ", RowBox[{"30", " ", "seconds"}], " ", "*)"}
             ]
            }
           ],
           "\[IndentingNewLine]",
           RowBox[
            {
             RowBox[
              {
               RowBox[
                {
                 "time",
                 "=",
                 RowBox[
                  {
                   RowBox[
                    {
                     "Range",
                     "[",
                     RowBox[{"0", ",", RowBox[{"n", "-", "1"}]}],
                     "]"
                    }
                   ],
                   "*",
                   "dt"
                  }
                 ]
                }
               ],
               ";"
              }
             ],
             "\[IndentingNewLine]"
            }
           ],
           "\[IndentingNewLine]",
           RowBox[
            {
             RowBox[{RowBox[{"radius", "=", "100"}], ";"}],
             " ",
             RowBox[
              {"(*", " ", RowBox[{"track", " ", "radius"}], " ", "*)"}
             ],
             "\[IndentingNewLine]",
             "\[IndentingNewLine]",
             RowBox[
              {
               "(*",
               " ",
               RowBox[
                {
                 "Tangential",
                 " ",
                 "speed",
                 " ",
                 RowBox[
                  {
                   "varies",
                   ":",
                   " ",
                   RowBox[
                    {
                     "the",
                     " ",
                     "car",
                     " ",
                     "accelerates",
                     " ",
                     "and",
                     " ",
                     "brakes",
                     " ",
                     "around",
                     " ",
                     "the",
                     " ",
                     "track"
                    }
                   ]
                  }
                 ]
                }
               ],
               " ",
               "*)"
              }
             ]
            }
           ],
           "\[IndentingNewLine]",
           RowBox[
            {
             RowBox[
              {
               RowBox[
                {
                 "vTang",
                 "=",
                 RowBox[
                  {
                   "30",
                   "+",
                   RowBox[
                    {
                     "8",
                     " ",
                     RowBox[
                      {
                       "Sin",
                       "[",
                       RowBox[{"2", " ", "Pi", " ", RowBox[{"time", "/", "20"}]}],
                       "]"
                      }
                     ]
                    }
                   ]
                  }
                 ]
                }
               ],
               ";"
              }
             ],
             "\[IndentingNewLine]",
             "\[IndentingNewLine]",
             RowBox[
              {
               "(*",
               " ",
               RowBox[
                {
                 "Integrate",
                 " ",
                 "the",
                 " ",
                 "speed",
                 " ",
                 "to",
                 " ",
                 "get",
                 " ",
                 "the",
                 " ",
                 "angle",
                 " ",
                 "around",
                 " ",
                 "the",
                 " ",
                 "circle"
                }
               ],
               " ",
               "*)"
              }
             ]
            }
           ],
           "\[IndentingNewLine]",
           RowBox[
            {
             RowBox[
              {
               "theta",
               "=",
               RowBox[
                {"ConstantArray", "[", RowBox[{"0", ",", "n"}], "]"}
               ]
              }
             ],
             ";"
            }
           ],
           "\[IndentingNewLine]",
           RowBox[
            {
             RowBox[
              {
               RowBox[
                {
                 "Do",
                 "[",
                 RowBox[
                  {
                   RowBox[
                    {
                     RowBox[{"theta", "[", RowBox[{"[", "i", "]"}], "]"}],
                     "=",
                     RowBox[
                      {
                       RowBox[
                        {
                         "theta",
                         "[",
                         RowBox[{"[", RowBox[{"i", "-", "1"}], "]"}],
                         "]"
                        }
                       ],
                       "+",
                       RowBox[
                        {
                         RowBox[
                          {
                           RowBox[
                            {
                             "vTang",
                             "[",
                             RowBox[{"[", RowBox[{"i", "-", "1"}], "]"}],
                             "]"
                            }
                           ],
                           "/",
                           "radius"
                          }
                         ],
                         "*",
                         "dt"
                        }
                       ]
                      }
                     ]
                    }
                   ],
                   ",",
                   RowBox[{"{", RowBox[{"i", ",", "2", ",", "n"}], "}"}]
                  }
                 ],
                 "]"
                }
               ],
               ";"
              }
             ],
             "\[IndentingNewLine]",
             "\[IndentingNewLine]",
             RowBox[
              {
               "(*",
               " ",
               RowBox[{"True", " ", "Cartesian", " ", "trajectory"}],
               " ",
               "*)"
              }
             ]
            }
           ],
           "\[IndentingNewLine]",
           RowBox[
            {
             RowBox[
              {
               "xTrue",
               "=",
               RowBox[{"radius", " ", RowBox[{"Cos", "[", "theta", "]"}]}]
              }
             ],
             ";"
            }
           ],
           "\[IndentingNewLine]",
           RowBox[
            {
             RowBox[
              {
               RowBox[
                {
                 "yTrue",
                 "=",
                 RowBox[{"radius", " ", RowBox[{"Sin", "[", "theta", "]"}]}]
                }
               ],
               ";"
              }
             ],
             "\[IndentingNewLine]",
             "\[IndentingNewLine]",
             RowBox[
              {
               "(*",
               " ",
               RowBox[{"Noisy", " ", "GPS", " ", "measurements"}],
               " ",
               "*)"
              }
             ]
            }
           ],
           "\[IndentingNewLine]",
           RowBox[{RowBox[{"sigma", "=", "3"}], ";"}],
           "\[IndentingNewLine]",
           RowBox[
            {
             RowBox[
              {
               "xMeas",
               "=",
               RowBox[
                {
                 "xTrue",
                 "+",
                 RowBox[
                  {
                   "RandomVariate",
                   "[",
                   RowBox[
                    {
                     RowBox[
                      {
                       "NormalDistribution",
                       "[",
                       RowBox[{"0", ",", "sigma"}],
                       "]"
                      }
                     ],
                     ",",
                     "n"
                    }
                   ],
                   "]"
                  }
                 ]
                }
               ]
              }
             ],
