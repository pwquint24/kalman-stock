            }
           ],
           "\[IndentingNewLine]",
           RowBox[
            {
             RowBox[
              {
               RowBox[
                {
                 "yMeas",
                 "=",
                 RowBox[
                  {
                   "yTrue",
                   "+",
                   RowBox[
                    {
                     "RandomVariate",
                     "[",
                     RowBox[
                      {
                       RowBox[
                        {
                         "NormalDistribution",
                         "[",
                         RowBox[{"0", ",", "sigma"}],
                         "]"
                        }
                       ],
                       ",",
                       "n"
                      }
                     ],
                     "]"
                    }
                   ]
                  }
                 ]
                }
               ],
               ";"
              }
             ],
             "\[IndentingNewLine]",
             "\[IndentingNewLine]",
             RowBox[
              {
               "(*",
               " ",
               RowBox[
                {
                 RowBox[{"2", "D", " ", "constant"}],
                 "-",
                 RowBox[{"acceleration", " ", "model"}]
                }
               ],
               " ",
               "*)"
              }
             ]
            }
           ],
           "\[IndentingNewLine]",
           RowBox[
            {
             RowBox[
              {
               "F2",
               "=",
               RowBox[
                {
                 "{",
                 RowBox[
                  {
                   RowBox[
                    {
                     "{",
                     RowBox[
                      {
                       "1",
                       ",",
                       "0",
                       ",",
                       "dt",
                       ",",
                       "0",
                       ",",
                       RowBox[{RowBox[{"dt", "^", "2"}], "/", "2"}],
                       ",",
                       "0"
                      }
                     ],
                     "}"
                    }
                   ],
                   ",",
                   RowBox[
                    {
                     "{",
                     RowBox[
                      {
                       "0",
                       ",",
                       "1",
                       ",",
                       "0",
                       ",",
                       "dt",
                       ",",
                       "0",
                       ",",
                       RowBox[{RowBox[{"dt", "^", "2"}], "/", "2"}]
                      }
                     ],
                     "}"
                    }
                   ],
                   ",",
                   "\[IndentingNewLine]",
                   "      ",
                   RowBox[
                    {
                     "{",
                     RowBox[
                      {"0", ",", "0", ",", "1", ",", "0", ",", "dt", ",", "0"}
                     ],
                     "}"
                    }
                   ],
                   ",",
                   RowBox[
                    {
                     "{",
                     RowBox[
                      {"0", ",", "0", ",", "0", ",", "1", ",", "0", ",", "dt"}
                     ],
                     "}"
                    }
                   ],
                   ",",
                   "\[IndentingNewLine]",
                   "      ",
                   RowBox[
                    {
                     "{",
                     RowBox[
                      {"0", ",", "0", ",", "0", ",", "0", ",", "1", ",", "0"}
                     ],
                     "}"
                    }
                   ],
                   ",",
                   RowBox[
                    {
                     "{",
                     RowBox[
                      {"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "1"}
                     ],
