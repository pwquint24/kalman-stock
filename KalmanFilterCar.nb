              }
             ]
            }
           ],
           "\[IndentingNewLine]",
           RowBox[
            {
             RowBox[
              {
               "G2",
               "=",
               RowBox[
                {
                 "{",
                 RowBox[
                  {
                   RowBox[
                    {
