              }
             ],
             "\[IndentingNewLine]"
            }
           ],
           "\[IndentingNewLine]",
           RowBox[
            {
             RowBox[{RowBox[{"qa2", "=", "1.0"}], ";"}],
             " ",
             RowBox[
              {
               "(*",
               " ",
               RowBox[
                {
                 "std",
                 " ",
                 "dev",
                 " ",
