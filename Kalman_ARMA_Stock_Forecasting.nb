                   "input" -> "x_t",
                   "state" -> "Boxes"
                  |>,
                  "TeXAssistantTemplate"
                 ],
                 TraditionalForm
                ]
               ]
              ],
              ": "
             }
            ],
            "Text"
           ],
           Cell[
            TextData[
             {
              Cell[
