        ],
        Cell[
         "We now extrapolate the Kalman trend forward into the test period: ",
         "CodeText"
        ],
        Cell[
         CellGroupData[
          {
           Cell[
            BoxData[
             RowBox[
              {
               RowBox[
                {
                 "(*",
                 " ",
                 RowBox[
                  {
                   "Forward",
                   " ",
                   "price",
                   " ",
                   "path",
                   " ",
                   "extrapolation",
                   " ",
                   "from",
                   " ",
                   "terminal",
                   " ",
                   "Kalman",
                   " ",
                   "state"
                  }
                 ],
                 " ",
                 "*)"
                }
               ],
               "\[IndentingNewLine]",
               "\t",
               RowBox[
                {
                 RowBox[
                  {
                   RowBox[
                    {
                     "mu0",
                     "=",
                     RowBox[{"finalState", "[", RowBox[{"[", "1", "]"}], "]"}]
                    }
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "beta0",
                     "=",
                     RowBox[{"finalState", "[", RowBox[{"[", "2", "]"}], "]"}]
                    }
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "kalmanPricePath",
                     "=",
                     RowBox[
                      {
                       "Table",
                       "[",
                       RowBox[
                        {
                         RowBox[{"mu0", "+", RowBox[{"k", "*", "beta0"}]}],
                         ",",
                         RowBox[{"{", RowBox[{"k", ",", "1", ",", "horizon"}], "}"}]
                        }
                       ],
                       "]"
                      }
                     ]
                    }
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   "(*",
                   " ",
                   RowBox[
                    {
                     "Analytical",
                     " ",
                     "expected",
                     " ",
                     "average",
                     " ",
                     "future",
                     " ",
                     "price",
                     " ",
                     "over",
                     " ",
                     "horizon",
                     " ",
                     "H"
                    }
                   ],
                   " ",
                   "*)"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "kalmanAvgPrice",
                     "=",
                     RowBox[
                      {
                       "mu0",
                       "+",
                       RowBox[
                        {
                         RowBox[
                          {
                           "(",
                           RowBox[
                            {
                             RowBox[{"(", RowBox[{"horizon", "+", "1"}], ")"}],
                             "/",
                             "2.0"
                            }
                           ],
                           ")"
                          }
                         ],
                         "*",
                         "beta0"
                        }
                       ]
                      }
                     ]
                    }
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "Print",
                     "[",
                     RowBox[
                      {
                       "\"Kalman Expected Average Future Price: $\"",
                       ",",
                       RowBox[
                        {
                         "NumberForm",
                         "[",
                         RowBox[
                          {
                           "kalmanAvgPrice",
                           ",",
                           RowBox[{"{", RowBox[{"6", ",", "2"}], "}"}]
                          }
                         ],
                         "]"
                        }
                       ]
                      }
                     ],
                     "]"
                    }
                   ],
                   ";"
                  }
                 ]
                }
               ]
              }
             ]
            ],
            "Input",
            CellLabel -> "In[65]:="
           ],
           Cell[
            BoxData[
             InterpretationBox[
              RowBox[
               {
                "\"Kalman Expected Average Future Price: $\"",
                "\[InvisibleSpace]",
                TagBox[
                 InterpretationBox[
                  StyleBox["\"594.88\"", ShowStringCharacters -> False],
                  594.88,
