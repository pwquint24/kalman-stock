            "expected",
            " ",
            "average",
            " ",
            "future",
            " ",
            "price",
            " ",
            "over",
            " ",
            "horizon",
            " ",
            "H"
           }
          ],
          " ",
          "*)"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "kalmanAvgPrice",
            "=",
            RowBox[
             {
              "mu0",
              "+",
              RowBox[
               {
                RowBox[
                 {
                  "(",
                  RowBox[
                   {
                    RowBox[{"(", RowBox[{"horizon", "+", "1"}], ")"}],
                    "/",
                    "2.0"
