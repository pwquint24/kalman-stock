                             }
                            ],
                            ")"
                           }
                          ],
                          "\[LongEqual]",
                          SubscriptBox["\[Mu]", StyleBox["T", "TI"]],
                          "+",
                          FractionBox[RowBox[{StyleBox["H", "TI"], "+", "1"}], "2"],
                          " ",
                          SubscriptBox["\[Beta]", StyleBox["T", "TI"]]
                         }
                        ],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "\\bar{P}_{\\text{Kalman}} = \\frac{1}{H} \\sum_{h=1}^{H} (\\mu_T + h\\,\\beta_T) = \\mu_T + \\frac{H + 1}{2}\\,\\beta_T",
                      "state" -> "Boxes"
