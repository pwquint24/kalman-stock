              Cell[
               "(A) The ARMA Process on Stock Returns",
               "Subsubsection"
              ],
              Cell[
               TextData[
                {
                 "Stock price levels ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        SubscriptBox[
                         StyleBox["P", FontSlant -> "Italic"],
                         StyleBox["t", "TI"]
                        ],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "\\mathit{P}_t",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " are non-stationary ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        RowBox[{StyleBox["I", "TI"], "(", "1", ")"}],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "I(1)",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " processes. Direct ARMA estimation on raw prices often fails or yields explosive roots (",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        RowBox[{"|", "\[Phi]", "|", "\[GreaterEqual]", "1"}],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "|\\phi| \\ge 1",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 "). We therefore model stationary continuously compounded log returns: ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        RowBox[
                         {
                          SubscriptBox[StyleBox["r", "TI"], StyleBox["t", "TI"]],
                          "\[LongEqual]",
                          "ln",
                          RowBox[
                           {
                            "(",
                            RowBox[
                             {
                              SubscriptBox[StyleBox["P", "TI"], StyleBox["t", "TI"]],
                              "/",
                              SubscriptBox[
                               StyleBox["P", "TI"],
                               RowBox[{StyleBox["t", "TI"], "-", "1"}]
                              ]
                             }
                            ],
                            ")"
                           }
                          ],
                          "\[LongEqual]",
                          "ln",
                          RowBox[
                           {
                            "(",
                            SubscriptBox[StyleBox["P", "TI"], StyleBox["t", "TI"]],
                            ")"
                           }
                          ],
                          "-",
                          "ln",
                          RowBox[
                           {
                            "(",
                            SubscriptBox[
                             StyleBox["P", "TI"],
                             RowBox[{StyleBox["t", "TI"], "-", "1"}]
                            ],
                            ")"
                           }
                          ]
                         }
                        ],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "r_t = \\ln(P_t / P_{t-1}) = \\ln(P_t) - \\ln(P_{t-1})",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 ". An ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        RowBox[
                         {
                          "ARMA",
                          "(",
                          RowBox[{StyleBox["p", "TI"], ",", StyleBox["q", "TI"]}],
                          ")"
                         }
                        ],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "\\text{ARMA}(p, q)",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " process for returns is defined as: ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        RowBox[
                         {
                          SubscriptBox[StyleBox["r", "TI"], StyleBox["t", "TI"]],
                          "\[LongEqual]",
                          StyleBox["c", "TI"],
                          "+",
                          UnderoverscriptBox[
                           "\[Sum]",
                           RowBox[{StyleBox["i", "TI"], "\[LongEqual]", "1"}],
                           StyleBox["p", "TI"],
                           LimitsPositioning -> True
                          ],
                          SubscriptBox["\[Phi]", StyleBox["i", "TI"]],
                          SubscriptBox[
                           StyleBox["r", "TI"],
                           RowBox[{StyleBox["t", "TI"], "-", StyleBox["i", "TI"]}]
                          ],
                          "+",
                          SubscriptBox["\[Epsilon]", StyleBox["t", "TI"]],
                          "+",
                          UnderoverscriptBox[
                           "\[Sum]",
                           RowBox[{StyleBox["j", "TI"], "\[LongEqual]", "1"}],
                           StyleBox["q", "TI"],
                           LimitsPositioning -> True
                          ],
                          SubscriptBox["\[Theta]", StyleBox["j", "TI"]],
                          SubscriptBox[
                           "\[Epsilon]",
                           RowBox[{StyleBox["t", "TI"], "-", StyleBox["j", "TI"]}]
                          ]
                         }
                        ],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "r_t = c + \\sum_{i=1}^{p} \\phi_i r_{t-i} + \\varepsilon_t + \\sum_{j=1}^{q} \\theta_j \\varepsilon_{t-j}",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 ". \nGiven multi-step forecasted returns ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        RowBox[
                         {
                          "{",
                          RowBox[
                           {
                            SubscriptBox[
                             StyleBox["r", "TI"],
                             RowBox[{StyleBox["T", "TI"], "+", "1"}]
                            ],
                            ",",
                            "\[Ellipsis]",
                            ",",
                            SubscriptBox[
                             StyleBox["r", "TI"],
                             RowBox[{StyleBox["T", "TI"], "+", StyleBox["H", "TI"]}]
                            ]
                           }
                          ],
                          "}"
                         }
                        ],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "\\{r_{T+1}, \\dots, r_{T+H}\\}",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 ", the reconstructed future price trajectory is: ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        RowBox[
                         {
                          SubscriptBox[
                           StyleBox["P", "TI"],
                           RowBox[{StyleBox["T", "TI"], "+", StyleBox["h", "TI"]}]
                          ],
                          "\[LongEqual]",
                          SubscriptBox[StyleBox["P", "TI"], StyleBox["T", "TI"]],
                          "exp",
                          RowBox[
                           {
                            "(",
                            RowBox[
                             {
                              UnderoverscriptBox[
                               "\[Sum]",
                               RowBox[{StyleBox["i", "TI"], "\[LongEqual]", "1"}],
                               StyleBox["h", "TI"],
                               LimitsPositioning -> True
                              ],
                              SubscriptBox[
                               StyleBox["r", "TI"],
                               RowBox[{StyleBox["T", "TI"], "+", StyleBox["i", "TI"]}]
                              ]
                             }
                            ],
                            ")"
                           }
                          ]
                         }
                        ],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "P_{T+h} = P_T \\exp\\left(\\sum_{i=1}^{h} r_{T+i}\\right)",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " \nThe expected average future price over horizon ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" -> FormBox[StyleBox["H", "TI"], TraditionalForm],
                      "errors" -> { },
                      "input" -> "H",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " is: ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        RowBox[
                         {
                          SubscriptBox[
                           OverscriptBox[StyleBox["P", "TI"], "_"],
                           "ARMA"
                          ],
                          "\[LongEqual]",
                          FractionBox["1", StyleBox["H", "TI"]],
                          UnderoverscriptBox[
                           "\[Sum]",
                           RowBox[{StyleBox["h", "TI"], "\[LongEqual]", "1"}],
                           StyleBox["H", "TI"],
                           LimitsPositioning -> True
                          ],
                          SubscriptBox[
                           StyleBox["P", "TI"],
                           RowBox[{StyleBox["T", "TI"], "+", StyleBox["h", "TI"]}]
                          ]
                         }
                        ],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "\\bar{P}_{\\text{ARMA}} = \\frac{1}{H} \\sum_{h=1}^{H} P_{T+h}",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ]
                }
               ],
               "Text"
              ],
              Cell[
               TextData[
                {
                 "In this formulation, ",
                 Cell[
                  BoxData[FormBox[SubscriptBox["P", "t"], TraditionalForm]]
                 ],
                 " denotes the observed stock price at time ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" -> FormBox[StyleBox["t", "TI"], TraditionalForm],
                      "errors" -> { },
                      "input" -> "t",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 ", while ",
                 Cell[
                  BoxData[FormBox[SubscriptBox["r", "t"], TraditionalForm]]
                 ],
                 " is the continuously compounded log return between periods ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        RowBox[{StyleBox["t", "TI"], "-", "1"}],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "t-1",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " and ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" -> FormBox[StyleBox["t", "TI"], TraditionalForm],
                      "errors" -> { },
                      "input" -> "t",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 ". The constant term ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" -> FormBox[StyleBox["c", "TI"], TraditionalForm],
                      "errors" -> { },
                      "input" -> "c",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " captures the average drift in returns. The coefficients ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        SubscriptBox["\[Phi]", StyleBox["i", "TI"]],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "\\phi_i",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " are the autoregressive parameters, measuring how current returns depend on their own past values ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        SubscriptBox[
                         StyleBox["r", "TI"],
                         RowBox[{StyleBox["t", "TI"], "-", StyleBox["i", "TI"]}]
                        ],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "r_{t-i}",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 ", and the coefficients ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        SubscriptBox["\[Theta]", StyleBox["j", "TI"]],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "\\theta_j",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " are the moving-average parameters, capturing the effect of past shocks ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        SubscriptBox[
                         "\[Epsilon]",
                         RowBox[{StyleBox["t", "TI"], "-", StyleBox["j", "TI"]}]
                        ],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "\\varepsilon_{t-j}",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " on current returns. The disturbance term ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        SubscriptBox["\[Epsilon]", StyleBox["t", "TI"]],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "\\varepsilon_t",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " represents an unpredictable innovation at time ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" -> FormBox[StyleBox["t", "TI"], TraditionalForm],
                      "errors" -> { },
                      "input" -> "t",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 ", typically assumed to have mean zero, constant variance, and no serial correlation. The orders ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" -> FormBox[StyleBox["p", "TI"], TraditionalForm],
                      "errors" -> { },
                      "input" -> "p",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " and ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" -> FormBox[StyleBox["q", "TI"], TraditionalForm],
                      "errors" -> { },
                      "input" -> "q",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " specify how many lagged returns and lagged shocks are included in the model, respectively."
                }
               ],
               "Text"
              ],
              Cell[
               TextData[
                {
                 "For forecasting, ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" -> FormBox[StyleBox["T", "TI"], TraditionalForm],
                      "errors" -> { },
                      "input" -> "T",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " denotes the last observed time period and ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" -> FormBox[StyleBox["H", "TI"], TraditionalForm],
                      "errors" -> { },
                      "input" -> "H",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " is the forecast horizon, so ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        RowBox[
                         {
                          SubscriptBox[
                           StyleBox["r", "TI"],
                           RowBox[{StyleBox["T", "TI"], "+", "1"}]
                          ],
                          ",",
                          "\[Ellipsis]",
                          ",",
                          SubscriptBox[
                           StyleBox["r", "TI"],
                           RowBox[{StyleBox["T", "TI"], "+", StyleBox["H", "TI"]}]
                          ]
                         }
                        ],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "r_{T+1}, \\dots, r_{T+H}",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " are the predicted future returns over the next ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" -> FormBox[StyleBox["H", "TI"], TraditionalForm],
                      "errors" -> { },
                      "input" -> "H",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " periods. Because log returns are additive across time, the cumulative return over ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" -> FormBox[StyleBox["h", "TI"], TraditionalForm],
                      "errors" -> { },
                      "input" -> "h",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " future steps is ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        RowBox[
                         {
                          UnderoverscriptBox[
                           "\[Sum]",
                           RowBox[{StyleBox["i", "TI"], "\[LongEqual]", "1"}],
                           StyleBox["h", "TI"],
                           LimitsPositioning -> True
                          ],
                          SubscriptBox[
                           StyleBox["r", "TI"],
                           RowBox[{StyleBox["T", "TI"], "+", StyleBox["i", "TI"]}]
                          ]
                         }
                        ],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "\\sum_{i=1}^{h} r_{T+i}",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 ", which is then exponentiated to convert back to the price scale. Multiplying by the last observed price ",
                 Cell[
                  BoxData[FormBox[SubscriptBox["P", "T"], TraditionalForm]]
                 ],
                 " gives the implied forecasted price ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        SubscriptBox[
                         StyleBox["P", "TI"],
                         RowBox[{StyleBox["T", "TI"], "+", StyleBox["h", "TI"]}]
                        ],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "P_{T+h}",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 ". Finally, ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        SubscriptBox[
                         OverscriptBox[StyleBox["P", "TI"], "_"],
                         "ARMA"
                        ],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "\\bar{P}_{\\text{ARMA}}",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " is the arithmetic average of the forecasted prices across all ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" -> FormBox[StyleBox["H", "TI"], TraditionalForm],
                      "errors" -> { },
                      "input" -> "H",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " future periods, providing a single summary measure of the expected price level over the forecast window."
                }
               ],
               "Text"
              ]
             },
             Open
            ]
           ],
           Cell[
            CellGroupData[
             {
              Cell[
               "(B) The Local Linear Trend (LLT) Kalman Filter",
               "Subsubsection"
              ],
              Cell[
               TextData[
                {
                 "The state-space model decomposes price ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        RowBox[
                         {
                          SubscriptBox[StyleBox["y", "TI"], StyleBox["t", "TI"]],
                          "\[LongEqual]",
                          SubscriptBox[StyleBox["P", "TI"], StyleBox["t", "TI"]]
                         }
                        ],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "y_t = P_t",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " into an unobserved dynamic level ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        SubscriptBox["\[Mu]", StyleBox["t", "TI"]],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "\\mu_t",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " and velocity/slope\n ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        SubscriptBox["\[Beta]", StyleBox["t", "TI"]],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "\\beta_t",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 ": ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        Cell[
                         BoxData[
                          FormBox[
                           GridBox[
                            {
                             {
                              Cell[
                               TextData[
                                {
                                 " ",
                                 Cell[
                                  BoxData[
                                   SubscriptBox[StyleBox["y", "TI"], StyleBox["t", "TI"]]
                                  ],
                                  "InlineFormula"
                                 ],
                                 " "
                                }
                               ]
                              ],
                              Cell[
                               TextData[
                                {
                                 " ",
                                 Cell[
                                  BoxData[
                                   RowBox[
                                    {
                                     "\[LongEqual]",
                                     SubscriptBox["\[Mu]", StyleBox["t", "TI"]],
                                     "+",
                                     SubscriptBox["\[Epsilon]", StyleBox["t", "TI"]],
                                     ","
                                    }
                                   ]
                                  ],
                                  "InlineFormula"
                                 ],
                                 " "
                                }
                               ]
                              ],
                              Cell[
                               TextData[
                                {
                                 " ",
                                 Cell[
                                  BoxData[SubscriptBox["\[Epsilon]", StyleBox["t", "TI"]]],
                                  "InlineFormula"
                                 ],
                                 " "
                                }
                               ]
                              ],
                              Cell[
                               TextData[
                                {
                                 " ",
                                 Cell[
                                  BoxData[
                                   RowBox[
                                    {
                                     "\[Tilde]",
                                     StyleBox["N", "TI"],
                                     RowBox[
                                      {
                                       "(",
                                       RowBox[
                                        {
                                         "0",
                                         ",",
                                         SubsuperscriptBox["\[Sigma]", "\[Epsilon]", "2"]
                                        }
                                       ],
                                       ")"
                                      }
                                     ]
                                    }
                                   ]
                                  ],
                                  "InlineFormula"
                                 ],
                                 " "
                                }
                               ]
                              ]
                             },
                             {
                              Cell[
                               TextData[
                                {
                                 " ",
                                 Cell[
                                  BoxData[
                                   SubscriptBox[
                                    "\[Mu]",
                                    RowBox[{StyleBox["t", "TI"], "+", "1"}]
                                   ]
                                  ],
                                  "InlineFormula"
                                 ],
                                 " "
                                }
                               ]
                              ],
                              Cell[
                               TextData[
                                {
                                 " ",
                                 Cell[
                                  BoxData[
                                   RowBox[
                                    {
                                     "\[LongEqual]",
                                     SubscriptBox["\[Mu]", StyleBox["t", "TI"]],
                                     "+",
                                     SubscriptBox["\[Beta]", StyleBox["t", "TI"]],
                                     "+",
                                     SubsuperscriptBox["\[Eta]", StyleBox["t", "TI"], "\[Mu]"],
                                     ","
                                    }
                                   ]
                                  ],
                                  "InlineFormula"
                                 ],
                                 " "
                                }
                               ]
                              ],
                              Cell[
                               TextData[
                                {
                                 " ",
                                 Cell[
                                  BoxData[
                                   SubsuperscriptBox["\[Eta]", StyleBox["t", "TI"], "\[Mu]"]
                                  ],
                                  "InlineFormula"
                                 ],
                                 " "
                                }
                               ]
                              ],
                              Cell[
                               TextData[
