            "Item"
           ],
           Cell[
            TextData[
             {
              StyleBox["Returns", FontWeight -> Bold],
              " are often treated as ",
              StyleBox["approximately stationary", FontWeight -> Bold],
              " over shorter periods."
             }
            ],
            "Item"
           ],
