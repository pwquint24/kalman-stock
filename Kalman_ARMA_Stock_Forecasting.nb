  Cell[
   "5. Out-of-Sample Performance Comparison (Single Window)",
   "Section"
  ],
  Cell[
   "We compare the ARMA and Kalman Filter forecasts against the actual realized out-of-sample stock prices over the 20-day test horizon. We also include the Naive Random Walk Benchmark (where future expected price equals the last observed price P_T). ",
   "Text"
  ],
  Cell[
   BoxData[
    RowBox[
     {
      RowBox[
       {
        "(*",
        " ",
        RowBox[
         {
          "Compute",
          " ",
          "realized",
          " ",
          "metrics",
          " ",
          "and",
          " ",
          "benchmark"
         }
        ],
        " ",
        "*)"
       }
      ],
      "\[IndentingNewLine]",
      RowBox[
       {
        RowBox[
         {
          RowBox[
           {
            "actualAvgPrice",
            "=",
            RowBox[{"Mean", "[", "testPrices", "]"}]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[{RowBox[{"naiveAvgPrice", "=", "pLast"}], ";"}],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "naivePricePath",
            "=",
            RowBox[
             {
              "ConstantArray",
              "[",
              RowBox[{"pLast", ",", "horizon"}],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          "(*",
          " ",
          RowBox[
           {
            "Percentage",
            " ",
            "errors",
            " ",
            "on",
            " ",
            "the",
            " ",
            "expected",
            " ",
            "average",
            " ",
            "price"
           }
          ],
          " ",
          "*)"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "armaAvgErrPct",
            "=",
            RowBox[
             {
              RowBox[
               {
                RowBox[
                 {
                  "Abs",
                  "[",
                  RowBox[{"armaAvgPrice", "-", "actualAvgPrice"}],
                  "]"
                 }
                ],
                "/",
                "actualAvgPrice"
               }
              ],
              "*",
              "100.0"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "kalmanAvgErrPct",
            "=",
            RowBox[
             {
              RowBox[
               {
                RowBox[
                 {
                  "Abs",
                  "[",
                  RowBox[{"kalmanAvgPrice", "-", "actualAvgPrice"}],
                  "]"
                 }
                ],
                "/",
                "actualAvgPrice"
               }
              ],
              "*",
              "100.0"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "naiveAvgErrPct",
            "=",
            RowBox[
             {
              RowBox[
               {
                RowBox[
                 {
                  "Abs",
                  "[",
                  RowBox[{"naiveAvgPrice", "-", "actualAvgPrice"}],
                  "]"
                 }
                ],
                "/",
                "actualAvgPrice"
               }
              ],
              "*",
              "100.0"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          "(*",
          " ",
          RowBox[
           {
            "Path",
            "-",
            RowBox[
             {
              "wise",
              " ",
              "Mean",
              " ",
              "Absolute",
              " ",
              "Error",
              " ",
              RowBox[{"(", "MAE", ")"}],
              " ",
              "and",
              " ",
              "Root",
              " ",
              "Mean",
              " ",
              "Squared",
              " ",
              "Error",
              " ",
              RowBox[{"(", "RMSE", ")"}]
             }
            ]
           }
          ],
          " ",
          "*)"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            RowBox[
             {"calcMAE", "[", RowBox[{"act_", ",", "pred_"}], "]"}
            ],
            ":=",
            RowBox[
             {
              "Mean",
              "[",
              RowBox[{"Abs", "[", RowBox[{"act", "-", "pred"}], "]"}],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            RowBox[
             {"calcRMSE", "[", RowBox[{"act_", ",", "pred_"}], "]"}
            ],
            ":=",
            RowBox[
             {
              "Sqrt",
              "[",
              RowBox[
               {
                "Mean",
                "[",
                RowBox[
                 {
                  RowBox[{"(", RowBox[{"act", "-", "pred"}], ")"}],
                  "^",
                  "2"
                 }
                ],
                "]"
               }
              ],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "armaMAE",
            "=",
            RowBox[
             {
              "calcMAE",
              "[",
              RowBox[{"testPrices", ",", "armaPricePath"}],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
