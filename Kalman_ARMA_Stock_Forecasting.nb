                             ",",
                             StyleBox["T", "TI"],
                             "+",
                             StyleBox["h", "TI"]
                            }
                           ]
                          ],
                          "\[LongEqual]",
                          SubscriptBox["\[Mu]", StyleBox["T", "TI"]],
                          "+",
                          StyleBox["h", "TI"],
                          " ",
                          SubscriptBox["\[Beta]", StyleBox["T", "TI"]]
                         }
                        ],
                        TraditionalForm
                       ],
                      "errors" -> { },
                      "input" -> "P_{\\text{Kalman}, T+h} = \\mu_T + h\\,\\beta_T",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 "The expected average future price over horizon ",
                 Cell[
                  BoxData[
                   FormBox[
