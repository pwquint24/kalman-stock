                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 " is analytically: ",
                 Cell[
                  BoxData[
                   FormBox[
                    TemplateBox[
                     <|
                      "boxes" ->
                       FormBox[
                        RowBox[
                         {
                          SubscriptBox[
                           OverscriptBox[StyleBox["P", "TI"], "_"],
                           "Kalman"
                          ],
                          "\[LongEqual]",
                          FractionBox["1", StyleBox["H", "TI"]],
                          UnderoverscriptBox[
                           "\[Sum]",
                           RowBox[{StyleBox["h", "TI"], "\[LongEqual]", "1"}],
