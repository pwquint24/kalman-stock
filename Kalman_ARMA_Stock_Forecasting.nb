     Cell[
      CellGroupData[
       {
        Cell[
         "4. Kalman Filtering for Dynamic Trend Extraction",
         "Section"
        ],
        Cell[
         TextData[
          {
           "We implement a 2D Local Linear Trend Kalman Filter in Wolfram Language. The state vector ",
           Cell[
            BoxData[
             FormBox[
              TemplateBox[
               <|
                "boxes" ->
                 FormBox[
                  RowBox[
                   {
                    SubscriptBox[StyleBox["x", "TI"], StyleBox["t", "TI"]],
                    "\[LongEqual]",
                    RowBox[
                     {
                      "[",
                      RowBox[
                       {
                        SubscriptBox["\[Mu]", StyleBox["t", "TI"]],
                        ",",
                        SubscriptBox["\[Beta]", StyleBox["t", "TI"]]
                       }
                      ],
                      "]"
                     }
                    ]
                   }
                  ],
                  TraditionalForm
                 ],
                "errors" -> { },
                "input" -> "x_t = [\\mu_t, \\beta_t]^\\top",
                "state" -> "Boxes"
               |>,
               "TeXAssistantTemplate"
              ],
              TraditionalForm
             ]
            ]
           ],
           " represents the true unobserved price trend level and its dynamic velocity (slope in $/day). The filter performs recursive Bayesian prediction and measurement updates, eliminating the phase lag inherent in standard moving averages. "
          }
         ],
         "Text"
        ],
        Cell[
         BoxData[
          RowBox[
           {
            RowBox[
             {
              "(*",
              " ",
              RowBox[
               {
                "Pure",
                " ",
                "Wolfram",
                " ",
                "Language",
                " ",
                "Implementation",
                " ",
                "of",
                " ",
                "Local",
                " ",
                "Linear",
                " ",
                "Trend",
                " ",
                "Kalman",
                " ",
                "Filter"
               }
              ],
              " ",
              "*)"
             }
            ],
            "\[IndentingNewLine]",
            "\t",
            RowBox[
             {
              RowBox[
               {
                RowBox[
                 {
                  "kalmanTrendFilter",
                  "[",
                  RowBox[
                   {
                    "data_List",
                    ",",
                    RowBox[{"qLevel_", " ", "?", " ", "NumericQ"}],
                    ",",
                    RowBox[{"qSlope_", " ", "?", " ", "NumericQ"}],
                    ",",
                    RowBox[{"rNoise_", " ", "?", " ", "NumericQ"}]
                   }
                  ],
                  "]"
                 }
                ],
                ":=",
                "\[IndentingNewLine]",
                "\t ",
                RowBox[
                 {
                  "Module",
                  "[",
                  RowBox[
                   {
                    RowBox[
                     {
                      "{",
                      RowBox[
                       {
                        RowBox[{"n", "=", RowBox[{"Length", "[", "data", "]"}]}],
                        ",",
                        "mu",
                        ",",
                        "beta",
                        ",",
                        "p11",
                        ",",
                        "p12",
                        ",",
                        "p22",
                        ",",
                        "k1",
                        ",",
                        "k2",
                        ",",
                        "y",
                        ",",
                        "v",
                        ",",
                        "f",
                        ",",
                        "\[IndentingNewLine]",
                        "\t         ",
                        "filteredMu",
                        ",",
                        "filteredBeta"
                       }
                      ],
                      "}"
                     }
                    ],
                    ",",
                    "\[IndentingNewLine]",
                    "\t  ",
                    RowBox[
                     {
                      "(*",
                      " ",
                      RowBox[
                       {
                        "Initialize",
                        " ",
                        "state",
                        " ",
                        "with",
                        " ",
                        "first",
                        " ",
                        "observed",
                        " ",
                        "price",
                        " ",
                        "and",
                        " ",
                        "zero",
                        " ",
                        "slope"
                       }
                      ],
                      " ",
                      "*)"
                     }
                    ],
                    "\[IndentingNewLine]",
                    "\t  ",
                    RowBox[
                     {
                      RowBox[
                       {
                        "mu",
                        "=",
                        RowBox[{"data", "[", RowBox[{"[", "1", "]"}], "]"}]
                       }
                      ],
                      ";",
                      "\[IndentingNewLine]",
                      "\t  ",
                      RowBox[{"beta", "=", "0.0"}],
                      ";",
                      "\[IndentingNewLine]",
                      "\t  ",
                      RowBox[
                       {
                        "(*",
                        " ",
                        RowBox[
                         {
                          "Initial",
                          " ",
                          "state",
                          " ",
                          "uncertainty",
                          " ",
                          "covariance"
                         }
                        ],
                        " ",
                        "*)"
                       }
                      ],
                      "\[IndentingNewLine]",
                      "\t  ",
                      RowBox[{"p11", "=", "1000.0"}],
                      ";",
                      " ",
                      RowBox[{"p12", "=", "0.0"}],
                      ";",
                      " ",
                      RowBox[{"p22", "=", "100.0"}],
                      ";",
                      "\[IndentingNewLine]",
                      "\t  ",
                      "\[IndentingNewLine]",
                      "\t  ",
                      RowBox[
                       {
                        "filteredMu",
                        "=",
                        RowBox[
                         {"ConstantArray", "[", RowBox[{"0.0", ",", "n"}], "]"}
                        ]
                       }
                      ],
                      ";",
                      "\[IndentingNewLine]",
                      "\t  ",
                      RowBox[
                       {
                        "filteredBeta",
                        "=",
                        RowBox[
                         {"ConstantArray", "[", RowBox[{"0.0", ",", "n"}], "]"}
                        ]
                       }
                      ],
                      ";",
                      "\[IndentingNewLine]",
                      "\t  ",
                      "\[IndentingNewLine]",
                      "\t  ",
                      RowBox[
                       {
                        "Do",
                        "[",
                        "\[IndentingNewLine]",
                        "\t    ",
                        RowBox[
                         {
                          RowBox[
                           {
                            RowBox[
                             {
                              "y",
                              "=",
                              RowBox[{"data", "[", RowBox[{"[", "t", "]"}], "]"}]
                             }
                            ],
                            ";",
                            "\[IndentingNewLine]",
                            "\t    ",
                            "\[IndentingNewLine]",
                            "\t    ",
                            RowBox[
                             {
                              "(*",
                              " ",
                              RowBox[{"1.", " ", "Predict", " ", "Step"}],
                              " ",
                              "*)"
                             }
                            ],
                            "\[IndentingNewLine]",
                            "\t    ",
                            RowBox[{"mu", "=", RowBox[{"mu", "+", "beta"}]}],
                            ";",
                            "\[IndentingNewLine]",
                            "\t    ",
                            RowBox[
                             {
                              "p11",
                              "=",
                              RowBox[
                               {
                                "p11",
                                "+",
                                RowBox[{"2.0", "*", "p12"}],
                                "+",
                                "p22",
                                "+",
                                "qLevel"
                               }
                              ]
                             }
                            ],
                            ";",
                            "\[IndentingNewLine]",
                            "\t    ",
                            RowBox[{"p12", "=", RowBox[{"p12", "+", "p22"}]}],
                            ";",
                            "\[IndentingNewLine]",
                            "\t    ",
                            RowBox[{"p22", "=", RowBox[{"p22", "+", "qSlope"}]}],
                            ";",
                            "\[IndentingNewLine]",
                            "\t    ",
                            "\[IndentingNewLine]",
                            "\t    ",
                            RowBox[
                             {
                              "(*",
                              " ",
                              RowBox[
                               {"2.", " ", "Measurement", " ", "Update", " ", "Step"}
                              ],
                              " ",
                              "*)"
                             }
                            ],
                            "\[IndentingNewLine]",
                            "\t    ",
                            RowBox[{"v", "=", RowBox[{"y", "-", "mu"}]}],
                            ";",
                            "           ",
                            RowBox[
                             {
                              "(*",
                              " ",
                              RowBox[{"Innovation", " ", "residual"}],
                              " ",
                              "*)"
                             }
                            ],
                            "\[IndentingNewLine]",
                            "\t    ",
                            RowBox[{"f", "=", RowBox[{"p11", "+", "rNoise"}]}],
                            ";",
                            "     ",
                            RowBox[
                             {
                              "(*",
                              " ",
                              RowBox[{"Innovation", " ", "variance"}],
                              " ",
                              "*)"
                             }
                            ],
                            "\[IndentingNewLine]",
                            "\t    ",
                            RowBox[{"k1", "=", RowBox[{"p11", "/", "f"}]}],
                            ";",
                            "         ",
                            RowBox[
                             {
                              "(*",
                              " ",
                              RowBox[{"Kalman", " ", "gain", " ", "for", " ", "level"}],
                              " ",
                              "*)"
                             }
                            ],
                            "\[IndentingNewLine]",
                            "\t    ",
                            RowBox[{"k2", "=", RowBox[{"p12", "/", "f"}]}],
                            ";",
                            "         ",
                            RowBox[
                             {
                              "(*",
                              " ",
                              RowBox[{"Kalman", " ", "gain", " ", "for", " ", "slope"}],
                              " ",
                              "*)"
                             }
                            ],
                            "\[IndentingNewLine]",
                            "\t    ",
                            "\[IndentingNewLine]",
                            "\t    ",
                            RowBox[
                             {"mu", "=", RowBox[{"mu", "+", RowBox[{"k1", "*", "v"}]}]}
                            ],
                            ";",
                            "\[IndentingNewLine]",
                            "\t    ",
                            RowBox[
                             {
                              "beta",
                              "=",
                              RowBox[{"beta", "+", RowBox[{"k2", "*", "v"}]}]
                             }
                            ],
                            ";",
                            "\[IndentingNewLine]",
                            "\t    ",
                            "\[IndentingNewLine]",
                            "\t    ",
                            RowBox[
                             {
                              "(*",
                              " ",
                              RowBox[{"Covariance", " ", "update"}],
                              " ",
                              "*)"
                             }
                            ],
                            "\[IndentingNewLine]",
                            "\t    ",
                            RowBox[
                             {
                              "p22",
                              "=",
                              RowBox[{"p22", "-", RowBox[{"k2", "*", "p12"}]}]
                             }
                            ],
                            ";",
                            "\[IndentingNewLine]",
                            "\t    ",
                            RowBox[
                             {
                              "p12",
                              "=",
                              RowBox[{"p12", "-", RowBox[{"k1", "*", "p12"}]}]
                             }
                            ],
                            ";",
                            "\[IndentingNewLine]",
                            "\t    ",
                            RowBox[
                             {
                              "p11",
                              "=",
                              RowBox[{"p11", "-", RowBox[{"k1", "*", "p11"}]}]
                             }
                            ],
                            ";",
                            "\[IndentingNewLine]",
                            "\t    ",
                            "\[IndentingNewLine]",
                            "\t    ",
                            RowBox[
                             {
                              RowBox[{"filteredMu", "[", RowBox[{"[", "t", "]"}], "]"}],
                              "=",
