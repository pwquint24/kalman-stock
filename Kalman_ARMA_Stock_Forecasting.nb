           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "meanKalmanMAPE",
            "=",
            RowBox[
             {
              "Mean",
              "[",
              RowBox[
               {
                "rollingResults",
                "[",
                RowBox[{"[", RowBox[{"All", ",", "\"Kalman_MAPE\""}], "]"}],
                "]"
               }
              ],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "meanNaiveMAPE",
            "=",
            RowBox[
             {
              "Mean",
              "[",
              RowBox[
               {
                "rollingResults",
                "[",
                RowBox[{"[", RowBox[{"All", ",", "\"Naive_MAPE\""}], "]"}],
                "]"
               }
              ],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "medArmaMAPE",
            "=",
            RowBox[
             {
              "Median",
              "[",
              RowBox[
               {
                "rollingResults",
                "[",
                RowBox[{"[", RowBox[{"All", ",", "\"ARMA_MAPE\""}], "]"}],
                "]"
               }
              ],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "medKalmanMAPE",
            "=",
            RowBox[
             {
              "Median",
              "[",
              RowBox[
               {
                "rollingResults",
                "[",
                RowBox[{"[", RowBox[{"All", ",", "\"Kalman_MAPE\""}], "]"}],
                "]"
               }
              ],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "medNaiveMAPE",
            "=",
            RowBox[
             {
              "Median",
              "[",
              RowBox[
               {
                "rollingResults",
                "[",
                RowBox[{"[", RowBox[{"All", ",", "\"Naive_MAPE\""}], "]"}],
                "]"
               }
              ],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "rmseArma",
            "=",
            RowBox[
             {
              "Sqrt",
              "[",
              RowBox[
               {
                "Mean",
                "[",
                RowBox[
                 {
                  RowBox[
                   {
                    "(",
                    RowBox[
                     {
                      RowBox[
                       {
                        "rollingResults",
                        "[",
                        RowBox[{"[", RowBox[{"All", ",", "\"ARMAAvg\""}], "]"}],
                        "]"
                       }
                      ],
                      "-",
                      RowBox[
                       {
                        "rollingResults",
                        "[",
                        RowBox[{"[", RowBox[{"All", ",", "\"ActualAvg\""}], "]"}],
                        "]"
                       }
                      ]
                     }
                    ],
                    ")"
                   }
                  ],
                  "^",
                  "2"
                 }
                ],
                "]"
               }
              ],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "rmseKalman",
            "=",
            RowBox[
             {
              "Sqrt",
              "[",
              RowBox[
               {
                "Mean",
                "[",
                RowBox[
                 {
                  RowBox[
                   {
                    "(",
                    RowBox[
                     {
                      RowBox[
                       {
                        "rollingResults",
                        "[",
                        RowBox[{"[", RowBox[{"All", ",", "\"KalmanAvg\""}], "]"}],
                        "]"
                       }
                      ],
                      "-",
                      RowBox[
                       {
                        "rollingResults",
                        "[",
                        RowBox[{"[", RowBox[{"All", ",", "\"ActualAvg\""}], "]"}],
                        "]"
                       }
                      ]
                     }
                    ],
                    ")"
                   }
                  ],
                  "^",
                  "2"
                 }
                ],
                "]"
               }
              ],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "rmseNaive",
            "=",
            RowBox[
             {
              "Sqrt",
              "[",
              RowBox[
               {
                "Mean",
                "[",
                RowBox[
                 {
                  RowBox[
                   {
                    "(",
                    RowBox[
                     {
                      RowBox[
                       {
                        "rollingResults",
                        "[",
                        RowBox[{"[", RowBox[{"All", ",", "\"NaiveAvg\""}], "]"}],
                        "]"
                       }
                      ],
                      "-",
                      RowBox[
                       {
                        "rollingResults",
                        "[",
                        RowBox[{"[", RowBox[{"All", ",", "\"ActualAvg\""}], "]"}],
                        "]"
                       }
                      ]
                     }
                    ],
                    ")"
                   }
                  ],
                  "^",
                  "2"
                 }
                ],
                "]"
               }
              ],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "winRateArma",
            "=",
            RowBox[
             {
              "Round",
              "[",
              RowBox[
               {
                RowBox[
                 {
                  RowBox[
                   {
                    "Count",
                    "[",
                    RowBox[
                     {
                      "rollingResults",
                      ",",
                      RowBox[
                       {
                        "r_",
                        " ",
                        "/;",
                        " ",
                        RowBox[
                         {
                          RowBox[{"r", "[", "\"ARMA_MAPE\"", "]"}],
                          "<",
                          RowBox[{"r", "[", "\"Naive_MAPE\"", "]"}]
                         }
                        ]
                       }
                      ]
                     }
                    ],
                    "]"
                   }
                  ],
                  "/",
                  RowBox[{"Length", "[", "rollingResults", "]"}]
                 }
                ],
                "*",
                "100"
               }
              ],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "winRateKalman",
            "=",
            RowBox[
             {
