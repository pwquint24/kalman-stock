          {
           Cell["2. Autocorrelation", "Subsection"],
           Cell[
            TextData[
             {
              StyleBox["Autocorrelation", FontWeight -> Bold],
              " means correlation of a series with its own past values."
             }
            ],
            "Text"
           ],
           Cell[
            "It measures whether knowing past observations helps predict the current one.",
            "Text"
           ],
           Cell[
            TextData[
             {
              "For lag ",
              Cell[
               BoxData[
                FormBox[
                 TemplateBox[
                  <|
                   "boxes" -> FormBox[StyleBox["k", "TI"], TraditionalForm],
                   "errors" -> { },
                   "input" -> "k",
                   "state" -> "Boxes"
                  |>,
                  "TeXAssistantTemplate"
                 ],
                 TraditionalForm
                ]
               ]
              ],
              ", the autocorrelation is roughly: ",
              Cell[
               BoxData[
                FormBox[
                 TemplateBox[
                  <|
                   "boxes" ->
                    FormBox[
                     RowBox[
                      {
                       SubscriptBox["\[Rho]", StyleBox["k", "TI"]],
                       "\[LongEqual]",
                       StyleBox["Corr", FontSlant -> "Plain"],
                       RowBox[
                        {
                         "(",
                         RowBox[
                          {
                           SubscriptBox[StyleBox["x", "TI"], StyleBox["t", "TI"]],
                           ",",
                           SubscriptBox[
                            StyleBox["x", "TI"],
                            RowBox[{StyleBox["t", "TI"], "-", StyleBox["k", "TI"]}]
                           ]
                          }
                         ],
                         ")"
                        }
                       ]
                      }
                     ],
                     TraditionalForm
                    ],
                   "errors" -> { },
                   "input" -> "\\rho_k = \\mathrm{Corr}(x_t, x_{t-k})",
                   "state" -> "Boxes"
                  |>,
                  "TeXAssistantTemplate"
                 ],
                 TraditionalForm
                ]
               ]
              ]
             }
            ],
            "Text"
           ],
           Cell[
            CellGroupData[
             {
              Cell["Interpretation", "Subsubsection"],
              Cell[
               TextData[
                {
                 StyleBox["Positive autocorrelation", FontWeight -> Bold],
                 ": high values tend to follow high values, low follow low."
                }
               ],
               "Item"
              ],
              Cell[
               TextData[
                {
                 StyleBox["Negative autocorrelation", FontWeight -> Bold],
                 ": high values tend to be followed by low values, and vice versa."
                }
               ],
               "Item"
              ],
              Cell[
               TextData[
                {
                 StyleBox["Near zero autocorrelation", FontWeight -> Bold],
                 ": the series has little linear dependence on its own past."
                }
               ],
               "Item"
              ]
             },
             Open
            ]
           ],
           Cell[
            CellGroupData[
             {
              Cell["In finance", "Subsubsection"],
              Cell["For returns: ", "Text"],
              Cell[
               "If returns have positive lag-1 autocorrelation, an up day may slightly increase the chance of another up day.",
               "Item"
              ],
              Cell[
               "If returns have negative lag-1 autocorrelation, reversals are more likely.",
               "Item"
              ],
              Cell[
               "ARMA models are designed precisely to capture this kind of dependence structure: ",
               "Text"
              ],
              Cell[
               TextData[
                {
                 StyleBox["AR part", FontWeight -> Bold],
                 ": dependence on past values,"
                }
               ],
               "Item"
              ],
              Cell[
               TextData[
                {
                 StyleBox["MA part", FontWeight -> Bold],
                 ": dependence on past shocks/errors."
                }
               ],
               "Item"
              ],
