                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "testPrices",
                     "=",
                     RowBox[
                      {
                       "rawPrices",
                       "[",
                       RowBox[
                        {
                         "[",
                         RowBox[
                          {
                           RowBox[{"nTrain", "+", "1"}],
                           " ",
                           ";;",
                           " ",
                           RowBox[{"nTrain", "+", "horizon"}]
                          }
                         ],
                         "]"
                        }
                       ],
                       "]"
                      }
                     ]
                    }
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "trainDates",
                     "=",
                     RowBox[
                      {
                       "tradingDates",
                       "[",
                       RowBox[{"[", RowBox[{"1", " ", ";;", " ", "nTrain"}], "]"}],
                       "]"
                      }
                     ]
                    }
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "testDates",
                     "=",
                     RowBox[
                      {
                       "tradingDates",
                       "[",
                       RowBox[
                        {
                         "[",
                         RowBox[
                          {
                           RowBox[{"nTrain", "+", "1"}],
                           " ",
                           ";;",
                           " ",
                           RowBox[{"nTrain", "+", "horizon"}]
                          }
                         ],
                         "]"
                        }
                       ],
                       "]"
