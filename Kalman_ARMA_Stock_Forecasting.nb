        ],
        Cell[
         "We now run the filter on the in-sample stock prices: ",
         "CodeText"
        ],
        Cell[
         CellGroupData[
          {
           Cell[
            BoxData[
             RowBox[
              {
               RowBox[
                {
                 "(*",
