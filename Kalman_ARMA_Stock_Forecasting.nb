  Cell[
   "6. Walk-Forward Backtesting (Rolling Window Evaluation)",
   "Section"
  ],
  Cell[
   "To rigorously verify model performance across differing market regimes (bull runs, pullbacks, and consolidations), we execute a walk-forward rolling backtest across 16 consecutive 20-day evaluation horizons spanning 2023\[Dash]2024.",
   "Text"
  ],
  Cell["In each window:", "Text"],
  Cell[
   "1. Models are trained on the preceding 250 trading days (1-year lookback).",
   "Text"
  ],
  Cell[
   "2. Models forecast expected average price over the subsequent 20 trading days.",
   "Text"
  ],
  Cell[
   "3. Errors relative to realized prices are systematically recorded. ",
   "Text"
  ],
  Cell[
   BoxData[
    RowBox[
     {
      RowBox[
       {
        "(*",
        " ",
        RowBox[
         {
          "Walk",
          "-",
          RowBox[
           {
            "Forward",
            " ",
            "Rolling",
            " ",
            "Evaluation",
            " ",
            "Engine"
           }
          ]
         }
        ],
        " ",
        "*)"
       }
      ],
      "\[IndentingNewLine]",
      RowBox[
       {
        RowBox[{RowBox[{"windowLookback", "=", "250"}], ";"}],
        "\[IndentingNewLine]",
        RowBox[{RowBox[{"evalHorizon", "=", "20"}], ";"}],
        "\[IndentingNewLine]",
        RowBox[{RowBox[{"stepSize", "=", "15"}], ";"}],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "rollingResults",
            "=",
            RowBox[
             {
              "Module",
              "[",
              RowBox[
               {
                RowBox[
                 {
                  "{",
                  RowBox[
                   {
                    RowBox[{"results", "=", RowBox[{"{", "}"}]}],
                    ",",
                    "tStart",
                    ",",
                    "tEnd",
                    ",",
                    "fEnd",
                    ",",
                    "train",
                    ",",
                    "future",
                    ",",
                    "\[IndentingNewLine]",
                    "                         ",
                    "muK",
                    ",",
                    "betaK",
                    ",",
                    "kRes",
                    ",",
                    "kalmanFC",
                    ",",
                    "kalmanAvg",
                    ",",
                    "\[IndentingNewLine]",
                    "                         ",
                    "logR",
                    ",",
                    "armaFit",
                    ",",
                    "armaFC",
                    ",",
                    "armaAvg",
                    ",",
                    "\[IndentingNewLine]",
                    "                         ",
                    "actAvg",
                    ",",
                    "naiveAvg",
                    ",",
                    "pTerminal"
                   }
                  ],
                  "}"
                 }
                ],
                ",",
                "\[IndentingNewLine]",
                "  ",
                RowBox[
                 {
                  RowBox[
                   {
                    "Do",
                    "[",
                    "\[IndentingNewLine]",
                    "    ",
                    RowBox[
                     {
                      RowBox[
                       {
                        RowBox[{"tStart", "=", "i"}],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {
                          "tEnd",
                          "=",
                          RowBox[{"i", "+", "windowLookback", "-", "1"}]
                         }
                        ],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[{"fEnd", "=", RowBox[{"tEnd", "+", "evalHorizon"}]}],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {
                          "If",
                          "[",
                          RowBox[
                           {
                            RowBox[{"fEnd", ">", "nTotal"}],
                            ",",
                            RowBox[{"Break", "[", "]"}]
                           }
                          ],
                          "]"
                         }
                        ],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {
                          "train",
                          "=",
                          RowBox[
                           {
                            "rawPrices",
                            "[",
                            RowBox[
                             {"[", RowBox[{"tStart", " ", ";;", " ", "tEnd"}], "]"}
                            ],
                            "]"
                           }
                          ]
                         }
                        ],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {
                          "future",
                          "=",
                          RowBox[
                           {
                            "rawPrices",
                            "[",
                            RowBox[
                             {
                              "[",
                              RowBox[
                               {RowBox[{"tEnd", "+", "1"}], " ", ";;", " ", "fEnd"}
                              ],
                              "]"
                             }
                            ],
                            "]"
                           }
                          ]
                         }
                        ],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {"pTerminal", "=", RowBox[{"Last", "[", "train", "]"}]}
                        ],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {"actAvg", "=", RowBox[{"Mean", "[", "future", "]"}]}
                        ],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[{"naiveAvg", "=", "pTerminal"}],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {
                          "(*",
                          " ",
                          RowBox[
                           {
                            "1.",
                            " ",
                            "Kalman",
                            " ",
                            "Linear",
                            " ",
                            "Trend",
                            " ",
                            "Filter"
                           }
                          ],
                          " ",
                          "*)"
                         }
                        ],
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {
                          "kRes",
                          "=",
                          RowBox[
                           {
                            "kalmanTrendFilter",
                            "[",
                            RowBox[{"train", ",", "1.0", ",", "0.05", ",", "5.0"}],
                            "]"
                           }
                          ]
                         }
                        ],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {
                          "muK",
                          "=",
                          RowBox[
                           {
                            RowBox[{"kRes", "[", "\"FinalState\"", "]"}],
                            "[",
                            RowBox[{"[", "1", "]"}],
                            "]"
                           }
                          ]
                         }
                        ],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {
                          "betaK",
                          "=",
                          RowBox[
                           {
                            RowBox[{"kRes", "[", "\"FinalState\"", "]"}],
                            "[",
                            RowBox[{"[", "2", "]"}],
                            "]"
                           }
                          ]
                         }
                        ],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {
                          "kalmanFC",
                          "=",
                          RowBox[
                           {
                            "Table",
                            "[",
                            RowBox[
                             {
                              RowBox[{"muK", "+", RowBox[{"k", "*", "betaK"}]}],
                              ",",
                              RowBox[
                               {"{", RowBox[{"k", ",", "1", ",", "evalHorizon"}], "}"}
                              ]
                             }
                            ],
                            "]"
                           }
                          ]
                         }
                        ],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {"kalmanAvg", "=", RowBox[{"Mean", "[", "kalmanFC", "]"}]}
                        ],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {
                          "(*",
                          " ",
                          RowBox[
                           {"2.", " ", "ARMA", " ", "on", " ", "Log", " ", "Returns"}
                          ],
                          " ",
                          "*)"
                         }
                        ],
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {
                          "logR",
                          "=",
                          RowBox[
                           {
                            "Differences",
                            "[",
                            RowBox[{"Log", "[", "train", "]"}],
                            "]"
                           }
                          ]
                         }
                        ],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {
                          "armaFit",
                          "=",
                          RowBox[
                           {
                            "Quiet",
                            "@",
                            RowBox[
                             {
                              "TimeSeriesModelFit",
                              "[",
                              RowBox[{"logR", ",", "\"ARMA\""}],
                              "]"
                             }
                            ]
                           }
                          ]
                         }
                        ],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {
                          "armaFC",
                          "=",
                          RowBox[
                           {
                            "Quiet",
                            "@",
                            RowBox[
                             {
                              RowBox[
                               {
                                "TimeSeriesForecast",
                                "[",
                                RowBox[{"armaFit", ",", RowBox[{"{", "evalHorizon", "}"}]}],
                                "]"
                               }
                              ],
                              "[",
                              "\"Values\"",
                              "]"
                             }
                            ]
                           }
                          ]
                         }
                        ],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {
                          "armaAvg",
                          "=",
                          RowBox[
                           {
                            "Mean",
                            "[",
                            RowBox[
                             {
                              "pTerminal",
                              "*",
                              RowBox[
                               {
                                "Exp",
                                "[",
                                RowBox[{"Accumulate", "[", "armaFC", "]"}],
                                "]"
                               }
                              ]
                             }
                            ],
                            "]"
                           }
                          ]
                         }
                        ],
                        ";",
                        "\[IndentingNewLine]",
                        "    ",
                        "\[IndentingNewLine]",
                        "    ",
                        RowBox[
                         {
                          "AppendTo",
                          "[",
                          RowBox[
                           {
                            "results",
                            ",",
                            RowBox[
                             {
                              "<|",
                              "\[IndentingNewLine]",
                              "      ",
                              RowBox[
                               {
                                RowBox[
                                 {
                                  "\"Window\"",
                                  "->",
                                  RowBox[{RowBox[{"Length", "[", "results", "]"}], "+", "1"}]
                                 }
                                ],
                                ",",
                                "\[IndentingNewLine]",
                                "      ",
                                RowBox[{"\"EndDay\"", "->", "tEnd"}],
                                ",",
                                "\[IndentingNewLine]",
                                "      ",
                                RowBox[{"\"ActualAvg\"", "->", "actAvg"}],
                                ",",
                                "\[IndentingNewLine]",
                                "      ",
                                RowBox[{"\"ARMAAvg\"", "->", "armaAvg"}],
                                ",",
                                "\[IndentingNewLine]",
                                "      ",
                                RowBox[{"\"KalmanAvg\"", "->", "kalmanAvg"}],
                                ",",
                                "\[IndentingNewLine]",
                                "      ",
                                RowBox[{"\"NaiveAvg\"", "->", "naiveAvg"}],
                                ",",
                                "\[IndentingNewLine]",
                                "      ",
                                RowBox[
                                 {
                                  "\"ARMA_MAPE\"",
                                  "->",
                                  RowBox[
                                   {
                                    RowBox[
                                     {
                                      RowBox[
                                       {"Abs", "[", RowBox[{"armaAvg", "-", "actAvg"}], "]"}
                                      ],
                                      "/",
                                      "actAvg"
                                     }
                                    ],
                                    "*",
                                    "100.0"
                                   }
                                  ]
                                 }
                                ],
                                ",",
                                "\[IndentingNewLine]",
                                "      ",
                                RowBox[
                                 {
                                  "\"Kalman_MAPE\"",
                                  "->",
                                  RowBox[
                                   {
                                    RowBox[
                                     {
                                      RowBox[
                                       {"Abs", "[", RowBox[{"kalmanAvg", "-", "actAvg"}], "]"}
                                      ],
                                      "/",
                                      "actAvg"
                                     }
                                    ],
                                    "*",
                                    "100.0"
                                   }
                                  ]
                                 }
                                ],
                                ",",
                                "\[IndentingNewLine]",
                                "      ",
                                RowBox[
                                 {
                                  "\"Naive_MAPE\"",
                                  "->",
                                  RowBox[
                                   {
                                    RowBox[
                                     {
                                      RowBox[
                                       {"Abs", "[", RowBox[{"naiveAvg", "-", "actAvg"}], "]"}
                                      ],
                                      "/",
                                      "actAvg"
                                     }
                                    ],
                                    "*",
                                    "100.0"
                                   }
                                  ]
                                 }
                                ]
                               }
                              ],
                              "\[IndentingNewLine]",
                              "    ",
                              "|>"
                             }
                            ]
                           }
                          ],
                          "]"
                         }
                        ],
                        ";"
                       }
                      ],
                      "\[IndentingNewLine]",
                      "  ",
                      ",",
                      RowBox[
                       {
                        "{",
                        RowBox[
                         {
                          "i",
                          ",",
                          "1",
                          ",",
                          RowBox[
                           {
                            "nTotal",
                            "-",
                            "windowLookback",
                            "-",
                            "evalHorizon",
                            "+",
                            "1"
                           }
                          ],
                          ",",
                          "stepSize"
                         }
                        ],
                        "}"
                       }
                      ]
                     }
                    ],
                    "]"
                   }
                  ],
                  ";",
                  "\[IndentingNewLine]",
                  "  ",
                  "results"
                 }
                ]
               }
              ],
              "\[IndentingNewLine]",
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "Print",
            "[",
            RowBox[
             {
              "\"Completed Walk-Forward Backtest across \"",
              ",",
              RowBox[{"Length", "[", "rollingResults", "]"}],
              ",",
              "\" evaluation windows.\""
             }
            ],
            "]"
           }
          ],
          ";"
         }
        ]
       }
      ]
     }
    ]
   ],
   "Input"
  ],
  Cell[
   "We now compute aggregate statistics across all 16 evaluation windows: ",
   "CodeText"
  ],
  Cell[
   BoxData[
    RowBox[
     {
      RowBox[
       {
        "(*",
        " ",
        RowBox[
         {
          "Aggregate",
          " ",
          "Statistical",
          " ",
          "Comparison",
          " ",
          "across",
          " ",
          "all",
          " ",
          "16",
          " ",
          "Windows"
         }
        ],
        " ",
        "*)"
       }
      ],
      "\[IndentingNewLine]",
      RowBox[
       {
        RowBox[
         {
          RowBox[
           {
            "meanArmaMAPE",
            "=",
            RowBox[
             {
              "Mean",
              "[",
              RowBox[
               {
                "rollingResults",
                "[",
                RowBox[{"[", RowBox[{"All", ",", "\"ARMA_MAPE\""}], "]"}],
