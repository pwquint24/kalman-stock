       Directive[
        LightDarkSwitched[GrayLevel[0.8], GrayLevel[0.48678]],
        AbsoluteThickness[1]
       ],
      GridBoxDividers -> {
       "Columns" -> {False, {True}, False},
       "Rows" -> {False, {True}, False}
      },
      GridBoxItemSize -> {"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}
     ],
     "Grid"
    ]
   ],
   "Text",
   "MarkdownDelimiter",
   ShowStringCharacters -> False,
   Background -> None
  ],
  Cell["3. ARMA Model Estimation on Returns", "Section"],
  Cell[
   "We partition the dataset into an in-sample training window (450 trading days) and an out-of-sample evaluation window (20 trading days, ~1 calendar month). We fit an ARMA process to stationary returns and forecast the future trajectory. ",
   "Text"
  ],
  Cell[
   BoxData[
    RowBox[
     {
      RowBox[
       {
        "(*",
        " ",
        RowBox[
         {
          RowBox[{"Split", " ", "data", " ", "into", " ", "In"}],
          "-",
          RowBox[{"Sample", " ", "Training", " ", "and", " ", "Out"}],
          "-",
          "of",
          "-",
          RowBox[{"Sample", " ", "Testing", " ", "sets"}]
         }
        ],
        " ",
        "*)"
       }
      ],
      "\[IndentingNewLine]",
      RowBox[
       {
        RowBox[{RowBox[{"nTrain", "=", "450"}], ";"}],
        "\[IndentingNewLine]",
        RowBox[{RowBox[{"horizon", "=", "20"}], ";"}],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "trainPrices",
            "=",
            RowBox[
             {
              "rawPrices",
              "[",
              RowBox[{"[", RowBox[{"1", " ", ";;", " ", "nTrain"}], "]"}],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "testPrices",
            "=",
            RowBox[
             {
              "rawPrices",
              "[",
              RowBox[
               {
                "[",
                RowBox[
                 {
                  RowBox[{"nTrain", "+", "1"}],
                  " ",
                  ";;",
                  " ",
                  RowBox[{"nTrain", "+", "horizon"}]
                 }
                ],
                "]"
               }
              ],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "trainDates",
            "=",
            RowBox[
             {
              "tradingDates",
              "[",
              RowBox[{"[", RowBox[{"1", " ", ";;", " ", "nTrain"}], "]"}],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "testDates",
            "=",
            RowBox[
             {
              "tradingDates",
              "[",
              RowBox[
               {
                "[",
                RowBox[
                 {
                  RowBox[{"nTrain", "+", "1"}],
                  " ",
                  ";;",
                  " ",
                  RowBox[{"nTrain", "+", "horizon"}]
                 }
                ],
                "]"
               }
              ],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "trainLogReturns",
            "=",
            RowBox[
             {
              "Differences",
              "[",
              RowBox[{"Log", "[", "trainPrices", "]"}],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "Print",
            "[",
            RowBox[
             {
              "\"Training sample size: \"",
              ",",
              RowBox[{"Length", "[", "trainPrices", "]"}],
              ",",
              "\" days.\""
             }
            ],
            "]"
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "Print",
            "[",
            RowBox[
             {
              "\"Testing forecast horizon: \"",
              ",",
              "horizon",
              ",",
              "\" days.\""
             }
            ],
            "]"
           }
          ],
          ";"
         }
        ]
       }
      ]
     }
    ]
   ],
   "Input"
  ],
  Cell[
   "We now estimate the optimal ARMA model using TimeSeriesModelFit: ",
   "CodeText"
  ],
  Cell[
   BoxData[
    RowBox[
     {
      RowBox[
       {
        "(*",
        " ",
        RowBox[
         {
          "Fit",
          " ",
          "an",
          " ",
          "ARMA",
          " ",
          "model",
          " ",
          "to",
          " ",
          "stationary",
          " ",
          "log",
          " ",
          "returns"
         }
        ],
        " ",
        "*)"
       }
      ],
      "\[IndentingNewLine]",
      RowBox[
       {
        RowBox[
         {
          RowBox[
           {
            "tsmARMA",
            "=",
            RowBox[
             {
              "TimeSeriesModelFit",
              "[",
              RowBox[{"trainLogReturns", ",", "\"ARMA\""}],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "fittedProcess",
            "=",
            RowBox[{"tsmARMA", "[", "\"Process\"", "]"}]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[{"Print", "[", "\"Fitted ARMA Process:\"", "]"}],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "fittedProcess"
       }
      ]
     }
    ]
   ],
   "Input"
  ],
  Cell[
   "We verify the model fit using residual diagnostics: ",
   "CodeText"
  ],
  Cell[
   BoxData[
    RowBox[
     {
      RowBox[
       {
        "(*",
        " ",
        RowBox[{"ARMA", " ", "Model", " ", "Diagnostics"}],
        " ",
        "*)"
       }
      ],
      "\[IndentingNewLine]",
      RowBox[
       {
        RowBox[
         {
          RowBox[
           {
            "residuals",
            "=",
            RowBox[
             {
              "Normal",
              "[",
              RowBox[
               {
                RowBox[{"tsmARMA", "[", "\"FitResiduals\"", "]"}],
                "[",
                "\"Values\"",
                "]"
               }
              ],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "pACF",
            "=",
            RowBox[
             {
              "ListPlot",
              "[",
              RowBox[
               {
                RowBox[
                 {
                  "Table",
                  "[",
                  RowBox[
                   {
                    RowBox[
                     {
                      "{",
                      RowBox[
                       {
                        "lag",
                        ",",
                        RowBox[
                         {
                          "Correlation",
                          "[",
                          RowBox[
                           {
                            RowBox[
                             {
                              "trainLogReturns",
                              "[",
                              RowBox[
                               {
                                "[",
                                RowBox[
                                 {
                                  "1",
                                  " ",
                                  ";;",
                                  " ",
                                  RowBox[{RowBox[{"-", "lag"}], "-", "1"}]
                                 }
                                ],
                                "]"
                               }
                              ],
                              "]"
                             }
                            ],
                            ",",
                            RowBox[
                             {
                              "trainLogReturns",
                              "[",
                              RowBox[
                               {
                                "[",
                                RowBox[
                                 {
                                  RowBox[{"lag", "+", "1"}],
                                  " ",
                                  ";;",
                                  " ",
                                  RowBox[{"-", "1"}]
                                 }
                                ],
                                "]"
                               }
                              ],
                              "]"
                             }
                            ]
                           }
                          ],
                          "]"
                         }
                        ]
                       }
                      ],
                      "}"
                     }
                    ],
                    ",",
                    RowBox[{"{", RowBox[{"lag", ",", "1", ",", "20"}], "}"}]
                   }
                  ],
                  "]"
                 }
                ],
                ",",
                "\[IndentingNewLine]",
                "  ",
                RowBox[{"Filling", "->", "Axis"}],
                ",",
                RowBox[
                 {
                  "PlotRange",
                  "->",
                  RowBox[
                   {"{", RowBox[{RowBox[{"-", "0.2"}], ",", "0.2"}], "}"}
                  ]
                 }
                ],
                ",",
                "\[IndentingNewLine]",
                "  ",
                RowBox[
                 {"PlotLabel", "->", "\"Autocorrelation of Returns\""}
                ],
                ",",
                RowBox[
                 {
                  "AxesLabel",
                  "->",
                  RowBox[{"{", RowBox[{"\"Lag\"", ",", "\"ACF\""}], "}"}]
                 }
                ],
                ",",
                RowBox[{"ImageSize", "->", "300"}]
               }
              ],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "pResHist",
            "=",
            RowBox[
             {
              "Histogram",
              "[",
              RowBox[
               {
                "residuals",
                ",",
                "30",
                ",",
                "\"PDF\"",
                ",",
                "\[IndentingNewLine]",
                "  ",
                RowBox[{"PlotLabel", "->", "\"Residual Distribution\""}],
                ",",
                RowBox[
                 {
                  "ChartStyle",
                  "->",
                  RowBox[
                   {
                    "RGBColor",
                    "[",
                    RowBox[{"0.2", ",", "0.6", ",", "0.8"}],
                    "]"
                   }
                  ]
                 }
                ],
                ",",
                RowBox[{"ImageSize", "->", "300"}]
               }
              ],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          "GraphicsRow",
          "[",
          RowBox[
           {
            RowBox[{"{", RowBox[{"pACF", ",", "pResHist"}], "}"}],
            ",",
            RowBox[{"ImageSize", "->", "600"}]
           }
          ],
          "]"
         }
        ]
       }
      ]
     }
    ]
   ],
   "Input"
  ],
  Cell[
   "Using the fitted ARMA model, we generate multi-step return forecasts and reconstruct the price trajectory: ",
   "CodeText"
  ],
  Cell[
   BoxData[
    RowBox[
     {
      RowBox[
       {
        "(*",
        " ",
        RowBox[
         {
          "Multi",
          "-",
          RowBox[
           {
            "step",
            " ",
            "forward",
            " ",
            "forecasting",
            " ",
            "of",
            " ",
            "returns"
           }
          ]
         }
        ],
        " ",
        "*)"
       }
      ],
      "\[IndentingNewLine]",
      RowBox[
       {
        RowBox[
         {
          RowBox[
           {
            "forecastReturns",
            "=",
            RowBox[
             {
              "Normal",
              "[",
              RowBox[
               {
                RowBox[
                 {
                  "TimeSeriesForecast",
                  "[",
                  RowBox[{"tsmARMA", ",", RowBox[{"{", "horizon", "}"}]}],
                  "]"
                 }
                ],
                "[",
                "\"Values\"",
                "]"
               }
              ],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          "(*",
          " ",
          RowBox[
           {
            "Reconstruct",
            " ",
            "expected",
            " ",
            "price",
            " ",
            "path",
            " ",
            "from",
            " ",
            "cumulative",
            " ",
            "forecasted",
            " ",
            "returns"
           }
          ],
          " ",
          "*)"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {"pLast", "=", RowBox[{"Last", "[", "trainPrices", "]"}]}
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "armaPricePath",
            "=",
            RowBox[
             {
              "pLast",
              "*",
              RowBox[
               {
                "Exp",
                "[",
                RowBox[{"Accumulate", "[", "forecastReturns", "]"}],
                "]"
               }
              ]
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          "(*",
          " ",
          RowBox[
           {
            RowBox[
             {
              "Compute",
              " ",
              "expected",
              " ",
              "average",
              " ",
              "future",
              " ",
              "price",
              " ",
              "over",
              " ",
              "the",
              " ",
              "20"
             }
            ],
            "-",
            RowBox[{"day", " ", "horizon"}]
           }
          ],
          " ",
          "*)"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "armaAvgPrice",
            "=",
            RowBox[{"Mean", "[", "armaPricePath", "]"}]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "Print",
            "[",
            RowBox[
             {
              "\"ARMA Expected Average Future Price: $\"",
              ",",
              RowBox[
               {
                "NumberForm",
                "[",
                RowBox[
                 {
                  "armaAvgPrice",
                  ",",
                  RowBox[{"{", RowBox[{"6", ",", "2"}], "}"}]
                 }
                ],
                "]"
               }
              ]
             }
            ],
            "]"
           }
          ],
          ";"
         }
        ]
       }
      ]
     }
    ]
   ],
   "Input"
  ],
  Cell[
   BoxData[
    TagBox[
     GridBox[
      {
       {TemplateBox[{0}, "Spacer1"]},
       {TemplateBox[{0}, "Spacer1"]}
      },
      AutoDelete -> False,
      FrameStyle ->
       Directive[
        LightDarkSwitched[GrayLevel[0.8], GrayLevel[0.48678]],
        AbsoluteThickness[1]
       ],
      GridBoxDividers -> {
       "Columns" -> {False, {True}, False},
       "Rows" -> {False, {True}, False}
      },
      GridBoxItemSize -> {"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}
     ],
     "Grid"
    ]
   ],
   "Text",
   "MarkdownDelimiter",
   ShowStringCharacters -> False,
   Background -> None
  ],
  Cell[
   "4. Kalman Filtering for Dynamic Trend Extraction",
   "Section"
  ],
  Cell[
   TextData[
    {
     "We implement a 2D Local Linear Trend Kalman Filter in Wolfram Language. The state vector x",
     StyleBox["t = [mu", FontSlant -> Italic],
     "t, beta_t]^T represents the true unobserved price trend level and its dynamic velocity (slope in $/day). The filter performs recursive Bayesian prediction and measurement updates, eliminating the phase lag inherent in standard moving averages. "
    }
   ],
   "Text"
  ],
  Cell[
   BoxData[
    RowBox[
     {
      RowBox[
       {
        "(*",
        " ",
        RowBox[
         {
          "Pure",
          " ",
          "Wolfram",
          " ",
          "Language",
          " ",
          "Implementation",
          " ",
          "of",
          " ",
          "Local",
          " ",
          "Linear",
          " ",
          "Trend",
          " ",
          "Kalman",
          " ",
          "Filter"
         }
        ],
        " ",
        "*)"
       }
      ],
      "\[IndentingNewLine]",
      RowBox[
       {
        RowBox[
         {
          RowBox[
           {
            "kalmanTrendFilter",
            "[",
            RowBox[
             {
              "data_List",
              ",",
              RowBox[{"qLevel_", "?", "NumericQ"}],
              ",",
              RowBox[{"qSlope_", "?", "NumericQ"}],
              ",",
              RowBox[{"rNoise_", "?", "NumericQ"}]
             }
            ],
            "]"
           }
          ],
          ":=",
          "\[IndentingNewLine]",
          " ",
          RowBox[
           {
            "Module",
            "[",
            RowBox[
             {
              RowBox[
               {
                "{",
                RowBox[
                 {
                  RowBox[{"n", "=", RowBox[{"Length", "[", "data", "]"}]}],
                  ",",
                  "mu",
                  ",",
                  "beta",
                  ",",
                  "p11",
                  ",",
                  "p12",
                  ",",
                  "p22",
                  ",",
                  "k1",
                  ",",
                  "k2",
                  ",",
                  "y",
                  ",",
                  "v",
                  ",",
                  "f",
                  ",",
                  "\[IndentingNewLine]",
                  "         ",
                  "filteredMu",
                  ",",
                  "filteredBeta"
                 }
                ],
                "}"
               }
              ],
              ",",
              "\[IndentingNewLine]",
              "  ",
              RowBox[
               {
                "(*",
                " ",
                RowBox[
                 {
                  "Initialize",
                  " ",
                  "state",
                  " ",
                  "with",
                  " ",
                  "first",
                  " ",
                  "observed",
                  " ",
                  "price",
                  " ",
                  "and",
                  " ",
                  "zero",
                  " ",
                  "slope"
                 }
                ],
                " ",
                "*)"
               }
              ],
              "\[IndentingNewLine]",
              "  ",
              RowBox[
               {
                RowBox[
                 {
                  "mu",
                  "=",
                  RowBox[{"data", "[", RowBox[{"[", "1", "]"}], "]"}]
                 }
                ],
                ";",
                "\[IndentingNewLine]",
                "  ",
                RowBox[{"beta", "=", "0.0"}],
                ";",
                "\[IndentingNewLine]",
                "  ",
                RowBox[
                 {
                  "(*",
                  " ",
                  RowBox[
                   {
                    "Initial",
                    " ",
                    "state",
                    " ",
                    "uncertainty",
                    " ",
                    "covariance"
                   }
                  ],
                  " ",
                  "*)"
                 }
                ],
                "\[IndentingNewLine]",
                "  ",
                RowBox[{"p11", "=", "1000.0"}],
                ";",
                " ",
                RowBox[{"p12", "=", "0.0"}],
                ";",
                " ",
                RowBox[{"p22", "=", "100.0"}],
                ";",
                "\[IndentingNewLine]",
                "  ",
                "\[IndentingNewLine]",
                "  ",
                RowBox[
                 {
                  "filteredMu",
                  "=",
                  RowBox[
                   {"ConstantArray", "[", RowBox[{"0.0", ",", "n"}], "]"}
                  ]
                 }
                ],
                ";",
                "\[IndentingNewLine]",
                "  ",
                RowBox[
                 {
                  "filteredBeta",
                  "=",
                  RowBox[
                   {"ConstantArray", "[", RowBox[{"0.0", ",", "n"}], "]"}
                  ]
                 }
                ],
                ";",
                "\[IndentingNewLine]",
                "  ",
                "\[IndentingNewLine]",
                "  ",
                RowBox[
                 {
                  "Do",
                  "[",
                  "\[IndentingNewLine]",
                  "    ",
                  RowBox[
                   {
                    RowBox[
                     {
                      RowBox[
                       {
                        "y",
                        "=",
                        RowBox[{"data", "[", RowBox[{"[", "t", "]"}], "]"}]
                       }
                      ],
                      ";",
                      "\[IndentingNewLine]",
                      "    ",
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[
                       {
                        "(*",
                        " ",
                        RowBox[{"1.", " ", "Predict", " ", "Step"}],
                        " ",
                        "*)"
                       }
                      ],
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[{"mu", "=", RowBox[{"mu", "+", "beta"}]}],
                      ";",
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[
                       {
                        "p11",
                        "=",
                        RowBox[
                         {
                          "p11",
                          "+",
                          RowBox[{"2.0", "*", "p12"}],
                          "+",
                          "p22",
                          "+",
                          "qLevel"
                         }
                        ]
                       }
                      ],
                      ";",
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[{"p12", "=", RowBox[{"p12", "+", "p22"}]}],
                      ";",
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[{"p22", "=", RowBox[{"p22", "+", "qSlope"}]}],
                      ";",
                      "\[IndentingNewLine]",
                      "    ",
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[
                       {
                        "(*",
                        " ",
                        RowBox[
                         {"2.", " ", "Measurement", " ", "Update", " ", "Step"}
                        ],
                        " ",
                        "*)"
                       }
                      ],
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[{"v", "=", RowBox[{"y", "-", "mu"}]}],
                      ";",
                      "           ",
                      RowBox[
                       {
                        "(*",
                        " ",
                        RowBox[{"Innovation", " ", "residual"}],
                        " ",
                        "*)"
                       }
                      ],
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[{"f", "=", RowBox[{"p11", "+", "rNoise"}]}],
                      ";",
                      "     ",
                      RowBox[
                       {
                        "(*",
                        " ",
                        RowBox[{"Innovation", " ", "variance"}],
                        " ",
                        "*)"
                       }
                      ],
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[{"k1", "=", RowBox[{"p11", "/", "f"}]}],
                      ";",
                      "         ",
                      RowBox[
                       {
                        "(*",
                        " ",
                        RowBox[{"Kalman", " ", "gain", " ", "for", " ", "level"}],
                        " ",
                        "*)"
                       }
                      ],
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[{"k2", "=", RowBox[{"p12", "/", "f"}]}],
                      ";",
                      "         ",
                      RowBox[
                       {
                        "(*",
                        " ",
                        RowBox[{"Kalman", " ", "gain", " ", "for", " ", "slope"}],
                        " ",
                        "*)"
                       }
                      ],
                      "\[IndentingNewLine]",
                      "    ",
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[
                       {"mu", "=", RowBox[{"mu", "+", RowBox[{"k1", "*", "v"}]}]}
                      ],
                      ";",
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[
                       {
                        "beta",
                        "=",
                        RowBox[{"beta", "+", RowBox[{"k2", "*", "v"}]}]
                       }
                      ],
                      ";",
                      "\[IndentingNewLine]",
                      "    ",
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[
                       {
                        "(*",
                        " ",
                        RowBox[{"Covariance", " ", "update"}],
                        " ",
                        "*)"
                       }
                      ],
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[
                       {
                        "p22",
                        "=",
                        RowBox[{"p22", "-", RowBox[{"k2", "*", "p12"}]}]
                       }
                      ],
                      ";",
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[
                       {
                        "p12",
                        "=",
                        RowBox[{"p12", "-", RowBox[{"k1", "*", "p12"}]}]
                       }
                      ],
                      ";",
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[
                       {
                        "p11",
                        "=",
                        RowBox[{"p11", "-", RowBox[{"k1", "*", "p11"}]}]
                       }
                      ],
                      ";",
                      "\[IndentingNewLine]",
                      "    ",
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[
                       {
                        RowBox[{"filteredMu", "[", RowBox[{"[", "t", "]"}], "]"}],
                        "=",
                        "mu"
                       }
                      ],
                      ";",
                      "\[IndentingNewLine]",
                      "    ",
                      RowBox[
                       {
                        RowBox[{"filteredBeta", "[", RowBox[{"[", "t", "]"}], "]"}],
                        "=",
                        "beta"
                       }
                      ],
                      ";"
                     }
                    ],
                    "\[IndentingNewLine]",
                    "  ",
                    ",",
                    RowBox[{"{", RowBox[{"t", ",", "1", ",", "n"}], "}"}]
                   }
                  ],
                  "]"
                 }
                ],
                ";",
                "\[IndentingNewLine]",
                "  ",
                "\[IndentingNewLine]",
                "  ",
                RowBox[
                 {
                  "<|",
                  "\[IndentingNewLine]",
                  "    ",
                  RowBox[
                   {
                    RowBox[{"\"Trend\"", "->", "filteredMu"}],
                    ",",
                    "\[IndentingNewLine]",
                    "    ",
                    RowBox[{"\"Slope\"", "->", "filteredBeta"}],
                    ",",
                    "\[IndentingNewLine]",
                    "    ",
                    RowBox[
                     {
                      "\"FinalState\"",
                      "->",
                      RowBox[{"{", RowBox[{"mu", ",", "beta"}], "}"}]
                     }
                    ],
                    ",",
                    "\[IndentingNewLine]",
                    "    ",
                    RowBox[
                     {
                      "\"FinalCov\"",
                      "->",
                      RowBox[
                       {
                        "{",
                        RowBox[
                         {
                          RowBox[{"{", RowBox[{"p11", ",", "p12"}], "}"}],
                          ",",
                          RowBox[{"{", RowBox[{"p12", ",", "p22"}], "}"}]
                         }
                        ],
                        "}"
                       }
                      ]
                     }
                    ]
                   }
                  ],
                  "\[IndentingNewLine]",
                  "  ",
                  "|>"
                 }
                ]
               }
              ]
             }
            ],
            "\[IndentingNewLine]",
            " ",
            "]"
           }
          ]
         }
        ],
        ";"
       }
      ]
     }
    ]
   ],
