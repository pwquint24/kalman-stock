           }
          ]
         }
        ],
        " ",
        "*)"
       }
      ],
      "\[IndentingNewLine]",
      RowBox[
       {
        RowBox[{RowBox[{"recentLookback", "=", "40"}], ";"}],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "historySegment",
            "=",
            RowBox[
             {
              "trainPrices",
              "[",
              RowBox[
               {
                "[",
                RowBox[
                 {
                  RowBox[{"-", "recentLookback"}],
                  " ",
                  ";;",
                  " ",
                  RowBox[{"-", "1"}]
                 }
                ],
