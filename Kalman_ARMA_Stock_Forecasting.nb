                     "expected",
                     " ",
                     "price",
                     " ",
                     "path",
                     " ",
                     "from",
                     " ",
                     "cumulative",
                     " ",
                     "forecasted",
                     " ",
                     "returns"
                    }
                   ],
                   " ",
                   "*)"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {"pLast", "=", RowBox[{"Last", "[", "trainPrices", "]"}]}
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "armaPricePath",
                     "=",
                     RowBox[
                      {
                       "pLast",
                       "*",
                       RowBox[
                        {
                         "Exp",
                         "[",
                         RowBox[{"Accumulate", "[", "forecastReturns", "]"}],
                         "]"
                        }
                       ]
                      }
                     ]
                    }
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
