                 "*)"
                }
               ],
               "\[IndentingNewLine]",
               "\t",
               RowBox[
                {
                 RowBox[
                  {
                   RowBox[
                    {
                     "forecastReturns",
                     "=",
                     RowBox[
                      {
                       "Normal",
                       "[",
                       RowBox[
                        {
                         RowBox[
                          {
                           "TimeSeriesForecast",
                           "[",
                           RowBox[{"tsmARMA", ",", RowBox[{"{", "horizon", "}"}]}],
                           "]"
                          }
                         ],
                         "[",
                         "\"Values\"",
                         "]"
                        }
                       ],
                       "]"
                      }
                     ]
                    }
