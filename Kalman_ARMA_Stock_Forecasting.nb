          {
           Cell["3. Drift rate", "Subsection"],
           Cell[
            TextData[
             {
              "The ",
              StyleBox["drift rate", FontWeight -> Bold],
              " is the long-run average tendency of a process to move upward or downward."
             }
            ],
            "Text"
           ],
           Cell[
            "In finance, drift is the expected average return per period.",
            "Text"
           ],
           Cell[
            TextData[
             {
              "If returns ",
              Cell[
               BoxData[
                FormBox[
                 TemplateBox[
                  <|
                   "boxes" ->
                    FormBox[
