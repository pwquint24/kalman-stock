  Cell[
   "We now extrapolate the Kalman trend forward into the test period: ",
   "CodeText"
  ],
  Cell[
   BoxData[
    RowBox[
     {
      RowBox[
       {
        "(*",
        " ",
        RowBox[
         {
          "Forward",
          " ",
          "price",
          " ",
          "path",
          " ",
          "extrapolation",
          " ",
          "from",
          " ",
          "terminal",
          " ",
          "Kalman",
          " ",
          "state"
         }
        ],
        " ",
        "*)"
       }
      ],
      "\[IndentingNewLine]",
      RowBox[
       {
        RowBox[
         {
          RowBox[
           {
