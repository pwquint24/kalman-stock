            "=",
            RowBox[{"finalState", "[", RowBox[{"[", "1", "]"}], "]"}]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "beta0",
            "=",
            RowBox[{"finalState", "[", RowBox[{"[", "2", "]"}], "]"}]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        RowBox[
         {
          RowBox[
           {
            "kalmanPricePath",
            "=",
            RowBox[
             {
              "Table",
              "[",
              RowBox[
               {
                RowBox[{"mu0", "+", RowBox[{"k", "*", "beta0"}]}],
                ",",
                RowBox[{"{", RowBox[{"k", ",", "1", ",", "horizon"}], "}"}]
               }
              ],
              "]"
             }
            ]
           }
          ],
          ";"
         }
        ],
        "\[IndentingNewLine]",
        "\[IndentingNewLine]",
        RowBox[
         {
          "(*",
