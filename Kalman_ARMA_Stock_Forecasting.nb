  Cell[
   "We visualize the forecast paths alongside actual realized prices and dashed mean lines: ",
   "CodeText"
  ],
  Cell[
   BoxData[
    RowBox[
     {
      RowBox[
       {
        "(*",
        " ",
        RowBox[
         {
