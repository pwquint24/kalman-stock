                       RowBox[
                        {
                         "[",
                         RowBox[
                          {
                           RowBox[{"nTrain", "+", "1"}],
                           " ",
                           ";;",
                           " ",
                           RowBox[{"nTrain", "+", "horizon"}]
                          }
                         ],
                         "]"
                        }
                       ],
                       "]"
