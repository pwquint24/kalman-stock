                       ],
                      "errors" -> { },
                      "input" -> "\\begin{aligned}\ny_t &= \\mu_t + \\varepsilon_t, & \\varepsilon_t &\\sim \\mathcal{N}(0, \\sigma_\\varepsilon^2) \\\\\n\\mu_{t+1} &= \\mu_t + \\beta_t + \\eta^\\mu_t, & \\eta^\\mu_t &\\sim \\mathcal{N}(0, \\sigma_\\mu^2) \\\\\n\\beta_{t+1} &= \\beta_t + \\eta^\\beta_t, & \\eta^\\beta_t &\\sim \\mathcal{N}(0, \\sigma_\\beta^2)\n\\end{aligned}",
                      "state" -> "Boxes"
                     |>,
                     "TeXAssistantTemplate"
                    ],
                    TraditionalForm
                   ]
                  ]
                 ],
                 "\n Forward extrapolation ",
