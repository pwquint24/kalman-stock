     Cell[
      CellGroupData[
       {
        Cell[
         "6. Walk-Forward Backtesting (Rolling Window Evaluation)",
         "Section"
        ],
        Cell[
         "To rigorously verify model performance across differing market regimes (bull runs, pullbacks, and consolidations), we execute a walk-forward rolling backtest across 16 consecutive 20-day evaluation horizons spanning 2023\[Dash]2024.",
         "Text"
        ],
        Cell["In each window:", "Text"],
        Cell[
         "1. Models are trained on the preceding 250 trading days (1-year lookback).",
         "Text"
        ],
        Cell[
         "2. Models forecast expected average price over the subsequent 20 trading days.",
         "Text"
        ],
        Cell[
         "3. Errors relative to realized prices are systematically recorded. ",
         "Text"
        ],
        Cell[
         CellGroupData[
          {
           Cell[
            BoxData[
             RowBox[
              {
               RowBox[
                {
                 "(*",
                 " ",
                 RowBox[
                  {
                   "Walk",
                   "-",
                   RowBox[
                    {
                     "Forward",
                     " ",
                     "Rolling",
                     " ",
                     "Evaluation",
                     " ",
                     "Engine"
                    }
                   ]
                  }
                 ],
                 " ",
                 "*)"
                }
               ],
               "\[IndentingNewLine]",
               "\t",
               RowBox[
                {
                 RowBox[{RowBox[{"windowLookback", "=", "250"}], ";"}],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[{RowBox[{"evalHorizon", "=", "20"}], ";"}],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[{RowBox[{"stepSize", "=", "15"}], ";"}],
                 "\[IndentingNewLine]",
                 "\t",
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "rollingResults",
                     "=",
                     RowBox[
                      {
                       "Module",
                       "[",
                       RowBox[
                        {
                         RowBox[
                          {
                           "{",
                           RowBox[
                            {
                             RowBox[{"results", "=", RowBox[{"{", "}"}]}],
                             ",",
                             "tStart",
                             ",",
                             "tEnd",
                             ",",
                             "fEnd",
                             ",",
                             "train",
                             ",",
                             "future",
                             ",",
                             "\[IndentingNewLine]",
                             "\t                         ",
                             "muK",
                             ",",
                             "betaK",
                             ",",
                             "kRes",
                             ",",
                             "kalmanFC",
                             ",",
                             "kalmanAvg",
                             ",",
                             "\[IndentingNewLine]",
                             "\t                         ",
                             "logR",
                             ",",
                             "armaFit",
                             ",",
                             "armaFC",
                             ",",
                             "armaAvg",
                             ",",
                             "\[IndentingNewLine]",
                             "\t                         ",
                             "actAvg",
                             ",",
                             "naiveAvg",
                             ",",
                             "pTerminal"
                            }
                           ],
                           "}"
                          }
                         ],
                         ",",
                         "\[IndentingNewLine]",
                         "\t  ",
                         RowBox[
                          {
                           RowBox[
                            {
                             "Do",
                             "[",
                             "\[IndentingNewLine]",
                             "\t    ",
                             RowBox[
                              {
                               RowBox[
                                {
                                 RowBox[{"tStart", "=", "i"}],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {
                                   "tEnd",
                                   "=",
                                   RowBox[{"i", "+", "windowLookback", "-", "1"}]
                                  }
                                 ],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[{"fEnd", "=", RowBox[{"tEnd", "+", "evalHorizon"}]}],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {
                                   "If",
                                   "[",
                                   RowBox[
                                    {
                                     RowBox[{"fEnd", ">", "nTotal"}],
                                     ",",
                                     RowBox[{"Break", "[", "]"}]
                                    }
                                   ],
                                   "]"
                                  }
                                 ],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {
                                   "train",
                                   "=",
                                   RowBox[
                                    {
                                     "rawPrices",
                                     "[",
                                     RowBox[
                                      {"[", RowBox[{"tStart", " ", ";;", " ", "tEnd"}], "]"}
                                     ],
                                     "]"
                                    }
                                   ]
                                  }
                                 ],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {
                                   "future",
                                   "=",
                                   RowBox[
                                    {
                                     "rawPrices",
                                     "[",
                                     RowBox[
                                      {
                                       "[",
                                       RowBox[
                                        {RowBox[{"tEnd", "+", "1"}], " ", ";;", " ", "fEnd"}
                                       ],
                                       "]"
                                      }
                                     ],
                                     "]"
                                    }
                                   ]
                                  }
                                 ],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {"pTerminal", "=", RowBox[{"Last", "[", "train", "]"}]}
                                 ],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {"actAvg", "=", RowBox[{"Mean", "[", "future", "]"}]}
                                 ],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[{"naiveAvg", "=", "pTerminal"}],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {
                                   "(*",
                                   " ",
                                   RowBox[
                                    {
                                     "1.",
                                     " ",
                                     "Kalman",
                                     " ",
                                     "Linear",
                                     " ",
                                     "Trend",
                                     " ",
                                     "Filter"
                                    }
                                   ],
                                   " ",
                                   "*)"
                                  }
                                 ],
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {
                                   "kRes",
                                   "=",
                                   RowBox[
                                    {
                                     "kalmanTrendFilter",
                                     "[",
                                     RowBox[{"train", ",", "1.0", ",", "0.05", ",", "5.0"}],
                                     "]"
                                    }
                                   ]
                                  }
                                 ],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {
                                   "muK",
                                   "=",
                                   RowBox[
                                    {
                                     RowBox[{"kRes", "[", "\"FinalState\"", "]"}],
                                     "[",
                                     RowBox[{"[", "1", "]"}],
                                     "]"
                                    }
                                   ]
                                  }
                                 ],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {
                                   "betaK",
                                   "=",
                                   RowBox[
                                    {
                                     RowBox[{"kRes", "[", "\"FinalState\"", "]"}],
                                     "[",
                                     RowBox[{"[", "2", "]"}],
                                     "]"
                                    }
                                   ]
                                  }
                                 ],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {
                                   "kalmanFC",
                                   "=",
                                   RowBox[
                                    {
                                     "Table",
                                     "[",
                                     RowBox[
                                      {
                                       RowBox[{"muK", "+", RowBox[{"k", "*", "betaK"}]}],
                                       ",",
                                       RowBox[
                                        {"{", RowBox[{"k", ",", "1", ",", "evalHorizon"}], "}"}
                                       ]
                                      }
                                     ],
                                     "]"
                                    }
                                   ]
                                  }
                                 ],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {"kalmanAvg", "=", RowBox[{"Mean", "[", "kalmanFC", "]"}]}
                                 ],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {
                                   "(*",
                                   " ",
                                   RowBox[
                                    {"2.", " ", "ARMA", " ", "on", " ", "Log", " ", "Returns"}
                                   ],
                                   " ",
                                   "*)"
                                  }
                                 ],
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {
                                   "logR",
                                   "=",
                                   RowBox[
                                    {
                                     "Differences",
                                     "[",
                                     RowBox[{"Log", "[", "train", "]"}],
                                     "]"
                                    }
                                   ]
                                  }
                                 ],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {
                                   "armaFit",
                                   "=",
                                   RowBox[
                                    {
                                     "Quiet",
                                     "@",
                                     RowBox[
                                      {
                                       "TimeSeriesModelFit",
                                       "[",
                                       RowBox[{"logR", ",", "\"ARMA\""}],
                                       "]"
                                      }
                                     ]
                                    }
                                   ]
                                  }
                                 ],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {
                                   "armaFC",
                                   "=",
                                   RowBox[
                                    {
                                     "Quiet",
                                     "@",
                                     RowBox[
                                      {
                                       RowBox[
                                        {
                                         "TimeSeriesForecast",
                                         "[",
                                         RowBox[{"armaFit", ",", RowBox[{"{", "evalHorizon", "}"}]}],
                                         "]"
                                        }
                                       ],
                                       "[",
                                       "\"Values\"",
                                       "]"
                                      }
                                     ]
                                    }
                                   ]
                                  }
                                 ],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {
                                   "armaAvg",
                                   "=",
                                   RowBox[
                                    {
                                     "Mean",
                                     "[",
                                     RowBox[
                                      {
                                       "pTerminal",
                                       "*",
                                       RowBox[
                                        {
                                         "Exp",
                                         "[",
                                         RowBox[{"Accumulate", "[", "armaFC", "]"}],
                                         "]"
                                        }
                                       ]
                                      }
                                     ],
                                     "]"
                                    }
                                   ]
                                  }
                                 ],
                                 ";",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 "\[IndentingNewLine]",
                                 "\t    ",
                                 RowBox[
                                  {
                                   "AppendTo",
                                   "[",
                                   RowBox[
                                    {
                                     "results",
                                     ",",
                                     RowBox[
                                      {
                                       "<|",
                                       "\[IndentingNewLine]",
                                       "\t      ",
                                       RowBox[
                                        {
                                         RowBox[
                                          {
                                           "\"Window\"",
                                           "->",
                                           RowBox[{RowBox[{"Length", "[", "results", "]"}], "+", "1"}]
                                          }
                                         ],
                                         ",",
