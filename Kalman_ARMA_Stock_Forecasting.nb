         "5. Out-of-Sample Performance Comparison (Single Window)",
         "Section"
        ],
        Cell[
         TextData[
          {
           "We compare the ARMA and Kalman Filter forecasts against the actual realized out-of-sample stock prices over the 20-day test horizon. We also include the Naive Random Walk Benchmark (where future expected price equals the last observed price ",
           Cell[
            BoxData[
             FormBox[
              TemplateBox[
               <|
                "boxes" ->
                 FormBox[
                  SubscriptBox[
                   StyleBox["P", FontSlant -> "Italic"],
                   StyleBox["T", "TI"]
                  ],
                  TraditionalForm
                 ],
                "errors" -> { },
                "input" -> "\\mathit{P}_T",
                "state" -> "Boxes"
               |>,
               "TeXAssistantTemplate"
              ],
              TraditionalForm
             ]
            ]
           ],
           "). "
          }
         ],
         "Text"
        ],
        Cell[
         BoxData[
          RowBox[
           {
            RowBox[
             {
              "(*",
              " ",
              RowBox[
               {
                "Compute",
                " ",
                "realized",
                " ",
                "metrics",
                " ",
                "and",
                " ",
                "benchmark"
               }
              ],
              " ",
              "*)"
             }
            ],
            "\[IndentingNewLine]",
            "\t",
            RowBox[
             {
              RowBox[
               {
                RowBox[
                 {
                  "actualAvgPrice",
                  "=",
                  RowBox[{"Mean", "[", "testPrices", "]"}]
                 }
                ],
                ";"
               }
              ],
              "\[IndentingNewLine]",
              "\t",
              RowBox[{RowBox[{"naiveAvgPrice", "=", "pLast"}], ";"}],
              "\[IndentingNewLine]",
              "\t",
              RowBox[
               {
                RowBox[
                 {
                  "naivePricePath",
                  "=",
                  RowBox[
                   {
                    "ConstantArray",
                    "[",
                    RowBox[{"pLast", ",", "horizon"}],
                    "]"
                   }
                  ]
                 }
                ],
                ";"
               }
              ],
              "\[IndentingNewLine]",
              "\t",
              "\[IndentingNewLine]",
              "\t",
              RowBox[
               {
                "(*",
                " ",
                RowBox[
                 {
                  "Percentage",
                  " ",
                  "errors",
                  " ",
                  "on",
                  " ",
                  "the",
                  " ",
                  "expected",
                  " ",
                  "average",
                  " ",
                  "price"
                 }
                ],
                " ",
                "*)"
               }
              ],
              "\[IndentingNewLine]",
              "\t",
              RowBox[
               {
                RowBox[
                 {
                  "armaAvgErrPct",
                  "=",
                  RowBox[
                   {
                    RowBox[
                     {
                      RowBox[
                       {
                        "Abs",
                        "[",
                        RowBox[{"armaAvgPrice", "-", "actualAvgPrice"}],
                        "]"
                       }
                      ],
                      "/",
                      "actualAvgPrice"
                     }
                    ],
                    "*",
                    "100.0"
                   }
                  ]
                 }
                ],
                ";"
               }
              ],
              "\[IndentingNewLine]",
              "\t",
              RowBox[
               {
                RowBox[
                 {
                  "kalmanAvgErrPct",
                  "=",
                  RowBox[
                   {
                    RowBox[
                     {
                      RowBox[
                       {
                        "Abs",
                        "[",
                        RowBox[{"kalmanAvgPrice", "-", "actualAvgPrice"}],
                        "]"
                       }
                      ],
                      "/",
                      "actualAvgPrice"
                     }
                    ],
