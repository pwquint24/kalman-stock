        Cell[
         "Using the fitted ARMA model, we generate multi-step return forecasts and reconstruct the price trajectory: ",
         "CodeText"
        ],
        Cell[
         CellGroupData[
          {
           Cell[
            BoxData[
             RowBox[
              {
               RowBox[
                {
                 "(*",
                 " ",
                 RowBox[
                  {
                   "Multi",
                   "-",
                   RowBox[
                    {
                     "step",
                     " ",
                     "forward",
                     " ",
                     "forecasting",
                     " ",
                     "of",
                     " ",
                     "returns"
                    }
                   ]
                  }
                 ],
                 " ",
                 "*)"
                }
               ],
               "\[IndentingNewLine]",
               "\t",
               RowBox[
                {
                 RowBox[
                  {
                   RowBox[
                    {
                     "forecastReturns",
                     "=",
                     RowBox[
                      {
                       "Normal",
                       "[",
                       RowBox[
                        {
                         RowBox[
                          {
                           "TimeSeriesForecast",
                           "[",
                           RowBox[{"tsmARMA", ",", RowBox[{"{", "horizon", "}"}]}],
                           "]"
                          }
                         ],
                         "[",
                         "\"Values\"",
                         "]"
                        }
                       ],
                       "]"
                      }
                     ]
                    }
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   "(*",
                   " ",
                   RowBox[
                    {
                     "Reconstruct",
                     " ",
                     "expected",
                     " ",
                     "price",
                     " ",
                     "path",
                     " ",
                     "from",
                     " ",
                     "cumulative",
                     " ",
                     "forecasted",
                     " ",
                     "returns"
                    }
                   ],
                   " ",
                   "*)"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {"pLast", "=", RowBox[{"Last", "[", "trainPrices", "]"}]}
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "armaPricePath",
                     "=",
                     RowBox[
                      {
                       "pLast",
                       "*",
                       RowBox[
                        {
                         "Exp",
                         "[",
                         RowBox[{"Accumulate", "[", "forecastReturns", "]"}],
                         "]"
                        }
                       ]
                      }
                     ]
                    }
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   "(*",
                   " ",
                   RowBox[
                    {
                     RowBox[
                      {
                       "Compute",
                       " ",
                       "expected",
                       " ",
                       "average",
                       " ",
                       "future",
                       " ",
                       "price",
                       " ",
                       "over",
                       " ",
                       "the",
                       " ",
                       "20"
                      }
                     ],
                     "-",
                     RowBox[{"day", " ", "horizon"}]
                    }
                   ],
                   " ",
                   "*)"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "armaAvgPrice",
                     "=",
                     RowBox[{"Mean", "[", "armaPricePath", "]"}]
