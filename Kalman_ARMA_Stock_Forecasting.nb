                              SubscriptBox[
                               StyleBox["r", "TI"],
                               RowBox[{StyleBox["t", "TI"], "+", StyleBox["h", "TI"]}]
                              ],
                              "|",
                              "information at ",
                              StyleBox["t", "TI"]
                             }
                            ],
                            "]"
                           }
                          ],
                          "\[Rule]",
                          "\[Mu]  ",
                          "as ",
