        Cell[
         "2. Stock Data Acquisition and Preprocessing",
         "Section"
        ],
        Cell[
         "We acquire daily historical data for the S&P 500 ETF (SPY) using Wolfram Language's built-in FinancialData. We convert Quantity expressions to pure numeric values and compute continuously compounded log returns. ",
         "Text"
        ],
        Cell[
         CellGroupData[
          {
           Cell[
            BoxData[
             RowBox[
              {
               RowBox[
                {
                 "(*",
                 " ",
                 RowBox[
                  {
                   "Define",
                   " ",
                   "stock",
                   " ",
                   "ticker",
                   " ",
                   "and",
                   " ",
                   "evaluation",
                   " ",
                   "date",
                   " ",
                   "range"
                  }
                 ],
                 " ",
                 "*)"
                }
               ],
               "\[IndentingNewLine]",
               "\t",
               RowBox[
                {
                 RowBox[{RowBox[{"ticker", "=", "\"SPY\""}], ";"}],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "startDate",
                     "=",
                     RowBox[{"{", RowBox[{"2023", ",", "1", ",", "1"}], "}"}]
                    }
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "endDate",
                     "=",
                     RowBox[{"{", RowBox[{"2024", ",", "12", ",", "31"}], "}"}]
                    }
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "Print",
                     "[",
                     RowBox[
                      {
                       "\"Fetching historical daily data for \"",
                       ",",
                       "ticker",
                       ",",
                       "\"...\""
                      }
                     ],
                     "]"
                    }
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "rawTS",
                     "=",
                     RowBox[
                      {
                       "FinancialData",
                       "[",
                       RowBox[
                        {
                         "ticker",
                         ",",
                         RowBox[{"{", RowBox[{"startDate", ",", "endDate"}], "}"}]
                        }
                       ],
                       "]"
                      }
                     ]
                    }
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   "(*",
                   " ",
                   RowBox[
                    {
                     "Extract",
                     " ",
                     "pure",
                     " ",
                     "numeric",
                     " ",
                     "prices",
                     " ",
                     "and",
                     " ",
                     "trading",
                     " ",
                     "dates"
                    }
                   ],
                   " ",
                   "*)"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "pricesTS",
                     "=",
                     RowBox[{"QuantityMagnitude", "[", "rawTS", "]"}]
                    }
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "tradingDates",
                     "=",
                     RowBox[{"pricesTS", "[", "\"Dates\"", "]"}]
                    }
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "rawPrices",
                     "=",
                     RowBox[
                      {
                       "Normal",
                       "[",
                       RowBox[{"pricesTS", "[", "\"Values\"", "]"}],
                       "]"
                      }
                     ]
                    }
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {"nTotal", "=", RowBox[{"Length", "[", "rawPrices", "]"}]}
                   ],
                   ";"
                  }
                 ],
                 "\[IndentingNewLine]",
                 "\t",
                 "\[IndentingNewLine]",
                 "\t",
                 RowBox[
                  {
                   RowBox[
                    {
                     "Print",
                     "[",
                     RowBox[
                      {
                       "\"Successfully loaded \"",
                       ",",
                       "nTotal",
                       ",",
                       "\" trading days from \"",
                       ",",
                       "\[IndentingNewLine]",
                       "\t  ",
                       RowBox[
                        {
                         "DateString",
                         "[",
